<odoo>
    <record id="payment_provider_form_hyperpay" model="ir.ui.view">
        <field name="name">payment.provider.form.hyperpay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='provider_credentials']|//group[@name='provider_credentials']" position="inside">
                <group invisible="code != 'hyperpay'">
                    <field name="hyperpay_access_token" password="True" required="code == 'hyperpay'"/>
                    <field name="hyperpay_entity_id_visa" required="code == 'hyperpay'"/>
                    <field name="hyperpay_entity_id_mada"/>
                    <field name="hyperpay_entity_id_applepay"/>
                </group>
            </xpath>
        </field>
    </record>
    <data noupdate="0">
        <!-- هذا الكود سيقوم بالبحث عن كل بوابات HyperPay في الداتابيز الحالية وتحديث بياناتها دفعة واحدة -->
        <function model="payment.provider" name="write">
            <!-- 1. شروط البحث: ابحث عن كل البوابات اللي الكود بتاعها hyperpay -->
            <value model="payment.provider" search="[('code', '=', 'hyperpay')]"/>
            <!-- 2. القيم المطلوب تحديثها (نفس فكرة الـ SQL بالظبط) -->
            <value eval="{
                'state': 'test',
                'is_published': True,
                'hyperpay_access_token': 'OGFjOWE0ZGE5ZDk2NTY0YzAxOWRhNTIzYWRiODExODB8OUw3Yj9VK0BRRG82TVF5ek0lRmQ=',
                'hyperpay_entity_id_visa': '8ac9a4ce9d965529019da52d8b8c32f2',
                'hyperpay_entity_id_mada': '8ac9a4ce9d965529019da52d8b8c32f2',
                'hyperpay_entity_id_applepay': '8ac9a4ce9d965529019da52d8b8c32f2'
            }"/>
        </function>
    </data>
</odoo>