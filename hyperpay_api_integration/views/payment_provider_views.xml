<odoo>
    <record id="payment_provider_form_hyperpay" model="ir.ui.view">
        <field name="name">payment.provider.form.hyperpay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='provider_credentials']|//group[@name='provider_credentials']" position="inside">
                <group invisible="code != 'hyperpay'">
                    <field name="hyperpay_access_token" password="True" required="code == 'hyperpay'"/>
                    <field name="hyperpay_entity_id_visa" required="code == 'hyperpay'"/>
                    <field name="hyperpay_entity_id_mada"/>
                    <field name="hyperpay_entity_id_applepay"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>