<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="redirect_form">
        <form t-att-action="url" method="get">
            <t t-foreach="inputs" t-as="input_name">
                <input type="hidden" t-att-name="input_name" t-att-value="inputs[input_name]"/>
            </t>
        </form>
    </template>
</odoo>