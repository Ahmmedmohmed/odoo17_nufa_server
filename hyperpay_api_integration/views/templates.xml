<odoo>
    <data>
        <template id="hyperpay_web_checkout_template" name="HyperPay Checkout">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <div class="container mt-5 mb-5 text-center">
                        <div class="card shadow-sm p-4">
                            <h3>إتمام عملية الدفع</h3>
                            <p class="text-muted">طلب رقم: <t t-esc="order.name"/></p>

                            <script t-attf-src="https://eu-test.oppwa.com/v1/paymentWidgets.js?checkoutId=#{checkout_id}"></script>

                            <script type="text/javascript">
                                var wpwlOptions = {
                                    style: "card",
                                    locale: "ar",
                                    paymentTarget: "_top",
                                }
                            </script>

                            <form t-attf-action="/api/hyperpay/verify_web"
                                  class="paymentWidgets"
                                  data-brands="VISA MASTER MADA APPLEPAY"
                                  id="hyperpay_payment_form"></form>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>