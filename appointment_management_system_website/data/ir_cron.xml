<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_cleanup_expired_reservations" model="ir.cron">
        <field name="name">Cleanup Expired Appointment Reservations</field>
        <field name="model_id" ref="appointment_management_system.model_appointment_management"/>
        <field name="state">code</field>
        <field name="code">model.cleanup_expired_reservations()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
        <field name="doall" eval="False"/>
    </record>
</odoo>