<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_server_confirm_appointment_order" model="ir.actions.server">
        <field name="name">Auto Confirm Appointment Sale Order</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">
for order in records:
    if order.appointment_ids and order.state in ('draft', 'sent'):
        order.action_confirm()
        </field>
    </record>

    <record id="auto_confirm_appointment_sale_order" model="base.automation">
        <field name="name">Auto Confirm Appointment Sale Orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="trigger">on_create_or_write</field>
        <field name="action_server_ids" eval="[(4, ref('action_server_confirm_appointment_order'))]"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
