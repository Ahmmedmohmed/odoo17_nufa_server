<?xml version="1.0" encoding="UTF-8"?>
<templates>
    
    <!-- Category item template -->
    <t t-name="appointment_booking.category_item">
        <div class="category_item" t-att-data-category-id="category.id">
            <div class="category_image">
                <t t-if="category.image">
                    <img t-att-src="category.image" t-att-alt="category.name"/>
                </t>
                <t t-else="">
                    <div class="category_placeholder"></div>
                </t>
            </div>
            <h4 class="category_name" t-esc="category.name"/>
        </div>
    </t>
    
    <!-- Service item template -->
    <t t-name="appointment_booking.service_item">
        <div class="service_item" t-att-data-service-id="service.id">
            <div class="service_image">
                <t t-if="service.image">
                    <img t-att-src="service.image" t-att-alt="service.name"/>
                </t>
                <t t-else="">
                    <div class="service_placeholder"></div>
                </t>
            </div>
            <div class="service_info">
                <h4 class="service_name" t-esc="service.name"/>
                <p class="service_description" t-esc="service.description"/>
                <div class="service_type">
                    <t t-if="service.is_service">
                        <span class="badge badge_service">Service</span>
                    </t>
                    <t t-if="service.is_package">
                        <span class="badge badge_package">Package</span>
                    </t>
                </div>
            </div>
        </div>
    </t>
    
    <!-- Date option template -->
    <t t-name="appointment_booking.date_option">
        <div class="date_option" t-att-data-date="date">
            <div class="date_day" t-esc="dayName"/>
            <div class="date_number" t-esc="dayNum"/>
            <div class="date_month" t-esc="monthName"/>
        </div>
    </t>
    
    <!-- Slot option template -->
    <t t-name="appointment_booking.slot_option">
        <div class="slot_option" t-att-data-slot-ids="JSON.stringify(slot.ids)">
            <span class="slot_time" t-esc="slot.name"/>
        </div>
    </t>
    
    <!-- Cart item template -->
    <t t-name="appointment_booking.cart_item">
        <div class="cart_item">
            <div class="cart_item_info">
                <h5 class="cart_item_name">Service #<t t-esc="item.service_id"/></h5>
                <p class="cart_item_details">
                    <t t-if="item.appointment_type === 'inside'">At Salon</t>
                    <t t-else="">At Your Location</t><br/>
                    <t t-esc="item.date"/>
                </p>
                <p class="cart_item_price"><t t-esc="item.service_currency or company_currency"/><t t-esc="(item.price || 0).toFixed(2)"/></p>
            </div>
            <button type="button" class="btn btn_remove remove_cart_item" t-att-data-cart-key="cartKey">
                <i class="fa fa-trash"></i>
            </button>
        </div>
    </t>
    
</templates>