<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_branch_popup" model="ir.ui.view">
        <field name="name">res.company.form.inherit.branch.popup</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_media']" position="before">
                <group string="Website Branch Settings">
                    <field name="show_in_branch_popup"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
