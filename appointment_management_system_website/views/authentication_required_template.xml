<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Authentication Required Template -->
        <template id="authentication_required_template" name="Authentication Required for Appointment Booking">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <div class="container mt-5">
                        <div class="row justify-content-center">
                            <div class="col-md-8 col-lg-6">
                                <div class="card shadow-lg border-0">
                                    <div class="card-body text-center p-5">
                                        <div class="mb-4">
                                            <i class="fa fa-lock fa-4x text-primary"></i>
                                        </div>
                                        
                                        <!-- Arabic Content -->
                                        <div t-if="request.env.context.get('lang', 'en').startswith('ar')" class="auth-content-ar">
                                            <h2 class="card-title text-primary mb-3">تسجيل الدخول مطلوب</h2>
                                            <p class="card-text text-muted mb-4 lead">يرجى تسجيل الدخول أو إنشاء حساب جديد لحجز موعد</p>
                                            
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <a href="/web/login" class="btn btn-primary btn-lg btn-block">
                                                        <i class="fa fa-sign-in mr-2"></i>
                                                        تسجيل الدخول
                                                    </a>
                                                    <small class="text-muted d-block mt-2">
                                                        لديك حساب بالفعل؟
                                                    </small>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <a href="/web/signup" class="btn btn-outline-primary btn-lg btn-block">
                                                        <i class="fa fa-user-plus mr-2"></i>
                                                        إنشاء حساب
                                                    </a>
                                                    <small class="text-muted d-block mt-2">
                                                        ليس لديك حساب؟
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- English Content -->
                                        <div t-else="" class="auth-content-en">
                                            <h2 class="card-title text-primary mb-3">Sign In Required</h2>
                                            <p class="card-text text-muted mb-4 lead">Please sign in or create an account to book an appointment</p>
                                            
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <a href="/web/login" class="btn btn-primary btn-lg btn-block">
                                                        <i class="fa fa-sign-in mr-2"></i>
                                                        Sign In
                                                    </a>
                                                    <small class="text-muted d-block mt-2">
                                                        Already have an account?
                                                    </small>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <a href="/web/signup" class="btn btn-outline-primary btn-lg btn-block">
                                                        <i class="fa fa-user-plus mr-2"></i>
                                                        Sign Up
                                                    </a>
                                                    <small class="text-muted d-block mt-2">
                                                        Don't have an account?
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Additional Information -->
                                        <div class="mt-4 pt-3 border-top">
                                            <div t-if="request.env.context.get('lang', 'en').startswith('ar')" class="text-muted">
                                                <small>
                                                    <i class="fa fa-info-circle mr-1"></i>
                                                    يمكنك حجز المواعيد وإدارة ملفك الشخصي بعد تسجيل الدخول
                                                </small>
                                            </div>
                                            <div t-else="" class="text-muted">
                                                <small>
                                                    <i class="fa fa-info-circle mr-1"></i>
                                                    You can book appointments and manage your profile after signing in
                                                </small>
                                            </div>
                                        </div>
                                        
                                        <!-- Decorative Elements -->
                                        <div class="mt-4">
                                            <div class="row text-center">
                                                <div class="col-4">
                                                    <div class="feature-icon">
                                                        <i class="fa fa-calendar fa-2x text-muted"></i>
                                                        <div t-if="request.env.context.get('lang', 'en').startswith('ar')">
                                                            <small class="text-muted">حجز المواعيد</small>
                                                        </div>
                                                        <div t-else="">
                                                            <small class="text-muted">Book Appointments</small>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="feature-icon">
                                                        <i class="fa fa-user fa-2x text-muted"></i>
                                                        <div t-if="request.env.context.get('lang', 'en').startswith('ar')">
                                                            <small class="text-muted">إدارة الملف الشخصي</small>
                                                        </div>
                                                        <div t-else="">
                                                            <small class="text-muted">Manage Profile</small>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="feature-icon">
                                                        <i class="fa fa-history fa-2x text-muted"></i>
                                                        <div t-if="request.env.context.get('lang', 'en').startswith('ar')">
                                                            <small class="text-muted">تاريخ المواعيد</small>
                                                        </div>
                                                        <div t-else="">
                                                            <small class="text-muted">Appointment History</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>