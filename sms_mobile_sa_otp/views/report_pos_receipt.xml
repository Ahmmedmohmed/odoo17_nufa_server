<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_invoice_a4" model="report.paperformat">
        <field name="name">Standard A4 Mobile Invoice</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_appointment_pos_receipt" model="ir.actions.report">
        <field name="name">فاتورة حجز موعد</field>
        <field name="model">appointment.management</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sms_mobile_sa_otp.report_smart_invoice_template</field>
        <field name="paperformat_id" ref="sms_mobile_sa_otp.paperformat_invoice_a4"/>
    </record>

    <record id="action_report_sale_pos_receipt" model="ir.actions.report">
        <field name="name">فاتورة مبيعات</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sms_mobile_sa_otp.report_smart_invoice_template</field>
        <field name="paperformat_id" ref="sms_mobile_sa_otp.paperformat_invoice_a4"/>
    </record>

    <template id="report_smart_invoice_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">

                    <t t-set="is_appointment" t-value="o._name == 'appointment.management'"/>
                    <t t-set="doc_name" t-value="o.appointment_ref if is_appointment else o.name"/>
                    <t t-set="doc_date" t-value="o.date if is_appointment else o.date_order"/>

                    <t t-set="appointment_lines" t-value="o.order_line.filtered(lambda l: 'appointment_id' in l and l.appointment_id) if not is_appointment and 'order_line' in o else []"/>
                    <t t-set="first_app" t-value="appointment_lines[0].appointment_id if appointment_lines else False"/>

                    <t t-set="seller_name" t-value="o.company_id.with_context(lang='ar_001').name"/>
                    <t t-set="branch_name" t-value="o.branch_id.with_context(lang='ar_001').name if is_appointment and 'branch_id' in o and o.branch_id else (first_app.branch_id.with_context(lang='ar_001').name if first_app and 'branch_id' in first_app and first_app.branch_id else seller_name)"/>

                    <t t-set="customer_name" t-value="o.partner_id.with_context(lang='ar_001').name if 'partner_id' in o and o.partner_id else 'عميل نقدي'"/>
                    <t t-set="main_employee" t-value="o.employee_id.with_context(lang='ar_001').name if is_appointment and 'employee_id' in o and o.employee_id else (first_app.employee_id.with_context(lang='ar_001').name if first_app and 'employee_id' in first_app and first_app.employee_id else 'غير محدد')"/>
                    <t t-set="app_date_real" t-value="o.date if is_appointment else (first_app.date if first_app else doc_date)"/>

                    <t t-set="subtotal_val" t-value="o.amount_untaxed if not is_appointment else o.price_unit / 1.15"/>
                    <t t-set="tax_val" t-value="o.amount_tax if not is_appointment else o.price_unit - (o.price_unit / 1.15)"/>
                    <t t-set="total_val" t-value="o.amount_total if not is_appointment else o.price_unit"/>

                    <t t-set="color_pink" t-value="'#df7b8e'"/>
                    <t t-set="color_light_pink" t-value="'#fdf5f6'"/>
                    <t t-set="color_text" t-value="'#333333'"/>
                    <t t-set="color_border" t-value="'#e6e6e6'"/>

                    <div class="page" style="font-family: 'Cairo', 'Tajawal', 'Arial', sans-serif; direction: rtl; text-align: right; color: #333; font-size: 13px;">

                        <div class="row" style="margin-bottom: 20px; border-bottom: 2px solid #df7b8e; padding-bottom: 15px; align-items: center;">
                            <div class="col-6 text-right">
                                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 90px; width: auto;" alt="Logo"/>
                            </div>
                            <div class="col-6 text-left" t-attf-style="color: {{color_pink}}; line-height: 1.2;">
                                <h3 style="font-weight: 800; margin: 0; font-size: 24px;">
                                    <t t-if="not is_appointment and o.state == 'cancel'">فاتورة مبيعات (ملغاة)</t>
                                    <t t-elif="is_appointment and o.state == '4'">حجز ملغي</t>
                                    <t t-else="">فاتورة ضريبية مبسطة</t>
                                </h3>
                                <h4 style="font-weight: 600; margin: 0; font-size: 18px;">
                                    <t t-if="not is_appointment and o.state == 'cancel'">Cancelled Invoice</t>
                                    <t t-elif="is_appointment and o.state == '4'">Cancelled Appointment</t>
                                    <t t-else="">Simplified Tax Invoice</t>
                                </h4>
                            </div>
                        </div>

                        <div class="row" style="margin-bottom: 20px;">
                            <div class="col-4">
                                <div t-attf-style="border: 1px solid {{color_border}}; border-radius: 12px; height: 100%; overflow: hidden;">
                                    <div t-attf-style="background-color: {{color_light_pink}}; color: {{color_pink}}; text-align: center; padding: 8px; font-weight: bold; border-bottom: 1px solid {{color_border}};">
                                        <i class="fa fa-store" style="margin-left: 5px;"></i> معلومات البائع
                                    </div>
                                    <div style="padding: 10px; line-height: 1.8;">
                                        <strong><t t-esc="seller_name"/></strong><br/>
                                        المملكة العربية السعودية - <t t-esc="o.company_id.with_context(lang='ar_001').city"/><br/>
                                        الرقم الضريبي: <span style="font-family: monospace;"><t t-esc="o.company_id.vat"/></span><br/>
                                        <i class="fa fa-phone" t-attf-style="color: {{color_pink}};"></i> <t t-esc="o.company_id.phone"/><br/>
                                        <i class="fa fa-envelope" t-attf-style="color: {{color_pink}};"></i> <t t-esc="o.company_id.email"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div t-attf-style="border: 1px solid {{color_border}}; border-radius: 12px; height: 100%; overflow: hidden;">
                                    <div t-attf-style="background-color: {{color_light_pink}}; color: {{color_pink}}; text-align: center; padding: 8px; font-weight: bold; border-bottom: 1px solid {{color_border}};">
                                        <i class="fa fa-file-text-o" style="margin-left: 5px;"></i> بيانات الفاتورة
                                    </div>
                                    <div style="padding: 10px; line-height: 1.8;">
                                        <div class="d-flex justify-content-between">
                                            <span>المرجع:</span> <strong><t t-esc="doc_name"/></strong>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>التاريخ:</span> <span><span t-esc="doc_date" t-options="{'widget': 'date', 'format': 'dd-MM-yyyy'}"/> <i class="fa fa-calendar" t-attf-style="color: {{color_pink}};"></i></span>
                                        </div>
                                        <div class="d-flex justify-content-between" t-if="not is_appointment and 'validity_date' in o and o.validity_date">
                                            <span>تاريخ الانتهاء:</span> <span><span t-esc="o.validity_date" t-options="{'widget': 'date', 'format': 'dd-MM-yyyy'}"/> <i class="fa fa-hourglass-half" t-attf-style="color: {{color_pink}};"></i></span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>المصدر:</span>
                                            <strong>
                                                <t t-esc="o.pos_reference if 'pos_reference' in o and o.pos_reference else doc_name"/>
                                                <i class="fa fa-tag" t-attf-style="color: {{color_pink}};"></i>
                                            </strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div t-attf-style="border: 1px solid {{color_border}}; border-radius: 12px; height: 100%; overflow: hidden;">
                                    <div t-attf-style="background-color: {{color_light_pink}}; color: {{color_pink}}; text-align: center; padding: 8px; font-weight: bold; border-bottom: 1px solid {{color_border}};">
                                        <i class="fa fa-user" style="margin-left: 5px;"></i> فاتورة إلى
                                    </div>
                                    <div style="padding: 10px; line-height: 1.8;">
                                        <strong><t t-esc="customer_name"/></strong><br/><br/>
                                        <t t-if="('phone' in o.partner_id and o.partner_id.phone) or ('mobile' in o.partner_id and o.partner_id.mobile)">
                                            <span style="font-family: monospace;"><t t-esc="o.partner_id.phone or o.partner_id.mobile"/></span> <i class="fa fa-phone" t-attf-style="color: {{color_pink}};"></i><br/>
                                        </t>
                                        <t t-if="('city' in o.partner_id and o.partner_id.city) or ('country_id' in o.partner_id and o.partner_id.country_id)">
                                            <t t-esc="o.partner_id.with_context(lang='ar_001').city"/> <t t-esc="o.partner_id.country_id.with_context(lang='ar_001').name"/> <i class="fa fa-map-marker" t-attf-style="color: {{color_pink}};"></i>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <t t-if="is_appointment or appointment_lines">
                            <div t-attf-style="border: 1px solid {{color_border}}; border-radius: 12px; overflow: hidden; margin-bottom: 20px;">
                                <div t-attf-style="background-color: {{color_light_pink}}; color: {{color_pink}}; text-align: right; padding: 8px 15px; font-weight: bold; border-bottom: 1px solid {{color_border}};">
                                    <i class="fa fa-calendar-check-o" style="margin-left: 5px;"></i> تفاصيل الموعد
                                </div>
                                <div class="row text-center" style="padding: 10px; font-size: 13px;">
                                    <div class="col-3" style="border-left: 1px solid #eee;">
                                        <span style="color: #777;">الموظفة <i class="fa fa-user-o" t-attf-style="color: {{color_pink}};"></i></span><br/>
                                        <strong><t t-esc="main_employee"/></strong>
                                    </div>
                                    <div class="col-3" style="border-left: 1px solid #eee;">
                                        <span style="color: #777;">التاريخ <i class="fa fa-calendar" t-attf-style="color: {{color_pink}};"></i></span><br/>
                                        <strong><span t-esc="app_date_real" t-options="{'widget': 'datetime', 'format': 'dd-MM-yyyy', 'tz_name': 'Asia/Riyadh'}"/></strong>
                                    </div>

                                    <div class="col-3" style="border-left: 1px solid #eee;">
                                        <span style="color: #777;">الوقت <i class="fa fa-clock-o" t-attf-style="color: {{color_pink}};"></i></span><br/>
                                        <t t-set="app_slot" t-value="o.slot_ids[0] if is_appointment and 'slot_ids' in o and o.slot_ids else (first_app.slot_ids[0] if first_app and 'slot_ids' in first_app and first_app.slot_ids else False)"/>
                                        <t t-if="app_slot">
                                            <t t-set="s_hour" t-value="int(app_slot.time)"/>
                                            <t t-set="s_minute" t-value="int(round((app_slot.time - s_hour) * 60))"/>
                                            <t t-set="s_ampm" t-value="'مساءً' if s_hour &gt;= 12 else 'صباحاً'"/>
                                            <t t-set="s_display_hour" t-value="s_hour - 12 if s_hour &gt; 12 else (12 if s_hour == 0 else s_hour)"/>
                                            <!-- تم التعديل هنا: تثبيت الدقائق على :00 -->
                                            <strong><t t-esc="'%02d:00 %s' % (s_display_hour, s_ampm)"/></strong>
                                        </t>
                                        <t t-else="">
                                            <!-- تم التعديل هنا: تغيير فورمات الدقائق إلى 00 -->
                                            <strong><span t-esc="app_date_real" t-options="{'widget': 'datetime', 'format': 'hh:00 a', 'tz_name': 'Asia/Riyadh'}"/></strong>
                                        </t>
                                    </div>

                                    <div class="col-3">
                                        <span style="color: #777;">الفرع <i class="fa fa-map-marker" t-attf-style="color: {{color_pink}};"></i></span><br/>
                                        <strong><t t-esc="branch_name"/></strong>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <table class="table table-borderless table-sm" style="width: 100%; font-size: 13px; margin-bottom: 20px; text-align: center;">
                            <thead t-attf-style="background-color: {{color_pink}}; color: white;">
                                <tr>
                                    <th style="padding: 10px; width: 5%;">#</th>
                                    <th style="padding: 10px; text-align: right; width: 35%;">الوصف</th>
                                    <th style="padding: 10px;">الكمية</th>
                                    <th style="padding: 10px;">سعر الوحدة</th>
                                    <th style="padding: 10px;">الإجمالي قبل الضريبة</th>
                                    <th style="padding: 10px;">الضريبة (%)</th>
                                    <th style="padding: 10px;">قيمة الضريبة</th>
                                    <th style="padding: 10px;">الإجمالي (شامل)</th>
                                </tr>
                            </thead>
                            <tbody style="border-bottom: 1px dashed #ccc;">
                                <t t-set="line_count" t-value="1"/>

                                <t t-if="is_appointment">
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <td style="padding-top: 15px;"><t t-esc="line_count"/></td>
                                        <td style="padding-top: 15px; text-align: right;">
                                            <strong style="font-size: 14px;"><t t-esc="o.product_id.with_context(lang='ar_001').name"/></strong>
                                            <t t-if="'is_appointment_package' in o.product_id and o.product_id.is_appointment_package">
                                                <span t-attf-style="color: {{color_pink}}; font-size: 11px; margin-right: 5px;">[باقة]</span>
                                                <ul style="margin: 2px 0; padding-right: 15px; font-size: 11px; color: #666;">
                                                    <t t-foreach="o.product_id.appointment_package_line_ids" t-as="p_line">
                                                        <li><t t-esc="p_line.product_id.with_context(lang='ar_001').name"/></li>
                                                    </t>
                                                </ul>
                                            </t>
                                            <t t-else="">
                                                <span t-attf-style="color: {{color_pink}}; font-size: 11px; margin-right: 5px;">[خدمة]</span>
                                            </t>
                                        </td>

                                        <td style="padding-top: 15px;">1.00</td>
                                        <td style="padding-top: 15px;"><t t-esc="subtotal_val" t-options='{"widget": "float", "precision": 2}'/> ر.س</td>
                                        <td style="padding-top: 15px;"><t t-esc="subtotal_val" t-options='{"widget": "float", "precision": 2}'/> ر.س</td>
                                        <td style="padding-top: 15px;">15%</td>
                                        <td style="padding-top: 15px;"><t t-esc="tax_val" t-options='{"widget": "float", "precision": 2}'/> ر.س</td>
                                        <td style="padding-top: 15px;"><strong><t t-esc="total_val" t-options='{"widget": "float", "precision": 2}'/> ر.س</strong></td>
                                    </tr>
                                </t>

                                <t t-elif="not is_appointment">
                                    <t t-foreach="o.order_line" t-as="line">
                                        <t t-if="not ('display_type' in line and line.display_type)">
                                            <tr style="border-bottom: 1px solid #eee;">
                                                <td style="padding-top: 15px;"><t t-esc="line_count"/></td>
                                                <td style="padding-top: 15px; text-align: right;">
                                                    <strong style="font-size: 14px;"><t t-esc="line.product_id.with_context(lang='ar_001').name"/></strong>

                                                    <t t-if="'is_appointment_package' in line.product_id and line.product_id.is_appointment_package">
                                                        <span t-attf-style="color: {{color_pink}}; font-size: 11px; margin-right: 5px;">[باقة]</span>
                                                        <ul style="margin: 2px 0; padding-right: 15px; font-size: 11px; color: #666;">
                                                            <t t-foreach="line.product_id.appointment_package_line_ids" t-as="p_line">
                                                                <li><t t-esc="p_line.product_id.with_context(lang='ar_001').name"/></li>
                                                            </t>
                                                        </ul>
                                                    </t>
                                                    <t t-elif="'detailed_type' in line.product_id and line.product_id.detailed_type == 'service'">
                                                        <span t-attf-style="color: {{color_pink}}; font-size: 11px; margin-right: 5px;">[خدمة]</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span t-attf-style="color: #6c757d; font-size: 11px; margin-right: 5px;">[منتج]</span>
                                                    </t>

                                                    <t t-if="'appointment_id' in line and line.appointment_id">
                                                        <br/>
                                                        <span style="font-size: 11px; color: #555;">
                                                            <i class="fa fa-calendar-check-o" style="color: #df7b8e;"></i> موعد:
                                                            <span t-esc="line.appointment_id.date" t-options="{'widget': 'date', 'format': 'yyyy-MM-dd'}"/> |

                                                            <t t-set="app_slot_line" t-value="line.appointment_id.slot_ids[0] if 'slot_ids' in line.appointment_id and line.appointment_id.slot_ids else False"/>
                                                            <t t-if="app_slot_line">
                                                                <t t-set="s_hour" t-value="int(app_slot_line.time)"/>
                                                                <t t-set="s_minute" t-value="int(round((app_slot_line.time - s_hour) * 60))"/>
                                                                <t t-set="s_ampm" t-value="'مساءً' if s_hour &gt;= 12 else 'صباحاً'"/>
                                                                <t t-set="s_display_hour" t-value="s_hour - 12 if s_hour &gt; 12 else (12 if s_hour == 0 else s_hour)"/>
                                                                <!-- تم التعديل هنا: تثبيت الدقائق على :00 -->
                                                                <strong style="color:#000;"><t t-esc="'%02d:00 %s' % (s_display_hour, s_ampm)"/></strong>
                                                            </t>
                                                            <t t-else="">
                                                                <!-- تم التعديل هنا: تغيير فورمات الدقائق إلى 00 -->
                                                                <strong style="color:#000;"><span t-esc="line.appointment_id.date" t-options="{'widget': 'datetime', 'format': 'hh:00 a', 'tz_name': 'Asia/Riyadh'}"/></strong>
                                                            </t>

                                                            <br/>
                                                            <i class="fa fa-user-o" style="color: #df7b8e;"></i> مع: <t t-esc="line.appointment_id.employee_id.with_context(lang='ar_001').name"/>
                                                        </span>
                                                    </t>

                                                </td>

                                                <td style="padding-top: 15px;"><t t-esc="line.product_uom_qty" t-options='{"widget": "float", "precision": 2}'/></td>
                                                <td style="padding-top: 15px;"><t t-esc="line.price_unit" t-options='{"widget": "float", "precision": 2}'/> ر.س</td>
                                                <td style="padding-top: 15px;"><t t-esc="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/> ر.س</td>
                                                <td style="padding-top: 15px;">15%</td>
                                                <td style="padding-top: 15px;"><t t-esc="line.price_tax" t-options='{"widget": "float", "precision": 2}'/> ر.س</td>
                                                <td style="padding-top: 15px;"><strong><t t-esc="line.price_total" t-options='{"widget": "float", "precision": 2}'/> ر.س</strong></td>
                                            </tr>
                                            <t t-set="line_count" t-value="line_count + 1"/>
                                        </t>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <div class="row" style="margin-bottom: 25px; align-items: stretch;">
                            <div class="col-7">
                                <div t-attf-style="border: 1px solid {{color_border}}; border-radius: 12px; padding: 15px; height: 100%; display: flex; flex-direction: column; justify-content: center;">
                                    <div t-attf-style="color: {{color_pink}}; font-weight: bold; margin-bottom: 10px; font-size: 14px;">
                                        المبلغ الإجمالي بالحروف <i class="fa fa-file-text-o" style="float: left;"></i>
                                    </div>
                                    <div style="font-size: 14px; font-weight: bold; color: #555; line-height: 1.6;">
                                        <t t-esc="o.company_id.currency_id.with_context(lang='ar_001').amount_to_text(total_val).replace('Riyals', 'ريال').replace('Riyal', 'ريال').replace('Halalas', 'هللة').replace('Halala', 'هللة').replace('and', 'و').replace('SAR', 'ريال سعودي')"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-5">
                                <div t-attf-style="border: 1px solid {{color_border}}; border-radius: 12px; overflow: hidden; height: 100%;">
                                    <div class="d-flex justify-content-between" style="padding: 10px 15px; border-bottom: 1px solid #eee;">
                                        <span style="color: #555;">الإجمالي قبل الضريبة</span>
                                        <strong><t t-esc="subtotal_val" t-options='{"widget": "float", "precision": 2}'/> ر.س</strong>
                                    </div>
                                    <div class="d-flex justify-content-between" style="padding: 10px 15px; border-bottom: 1px solid #eee;">
                                        <span style="color: #555;">الضريبة المضافة (15%)</span>
                                        <strong><t t-esc="tax_val" t-options='{"widget": "float", "precision": 2}'/> ر.س</strong>
                                    </div>
                                    <div class="d-flex justify-content-between" t-attf-style="padding: 12px 15px; background-color: {{color_pink}}; color: white; font-size: 16px;">
                                        <strong>الإجمالي شامل الضريبة</strong>
                                        <strong><t t-esc="total_val" t-options='{"widget": "float", "precision": 2}'/> ر.س</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row text-center" style="font-size: 12px; margin-bottom: 20px;">

                            <div class="col-4">
                                <div t-attf-style="border: 1px solid {{color_border}}; border-radius: 12px; padding: 10px; height: 100%;">
                                    <div class="text-right" style="margin-bottom: 5px;"><i class="fa fa-credit-card" style="color: #df7b8e;"></i> <span style="color: #777;">طريقة الدفع</span></div>
                                    <strong style="font-size: 13px;">
                                        <t t-set="pay_method_name" t-value="''"/>

                                        <t t-if="is_appointment and 'payment_method_id' in o and o.payment_method_id">
                                            <t t-set="pay_method_name" t-value="o.payment_method_id.with_context(lang='ar_001').name"/>
                                        </t>
                                        <t t-elif="not is_appointment and 'appointment_ids' in o and o.appointment_ids and 'payment_method_id' in o.appointment_ids[0] and o.appointment_ids[0].payment_method_id">
                                            <t t-set="pay_method_name" t-value="o.appointment_ids[0].payment_method_id.with_context(lang='ar_001').name"/>
                                        </t>

                                        <t t-if="pay_method_name">
                                            <t t-esc="pay_method_name"/>
                                        </t>
                                        <t t-else="">نقدي / شبكة إلكترونية</t>
                                    </strong>

                                    <hr style="margin: 8px 0; border-top: 1px dashed #eee;"/>

                                    <div class="text-right" style="margin-bottom: 5px;"><i class="fa fa-check-circle-o" style="color: #df7b8e;"></i> <span style="color: #777;">شروط الدفع</span></div>
                                    <strong style="font-size: 13px;">
                                        <t t-if="not is_appointment and 'payment_term_id' in o and o.payment_term_id">
                                            <t t-esc="o.payment_term_id.with_context(lang='ar_001').name"/>
                                        </t>
                                        <t t-else="">فوري</t>
                                    </strong>
                                </div>
                            </div>

                            <div class="col-5">
                                <div t-attf-style="border: 1px solid {{color_border}}; border-radius: 12px; padding: 10px; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; background-color: #fafafa;">
                                    <span t-attf-style="color: {{color_pink}}; font-weight: bold; margin-bottom: 5px;">ملاحظات وشروط عامة</span>
                                    <span style="color: #555; line-height: 1.8;">
                                        <t t-if="not is_appointment and 'note' in o and o.note">
                                            <t t-esc="o.note"/>
                                        </t>
                                        <t t-else="">
                                            شكراً لاختياركم <t t-esc="seller_name"/><br/>
                                            نسعد بخدمتكم دائماً
                                        </t>
                                    </span>
                                </div>
                            </div>

                            <div class="col-3">
                                <div style="height:100%; display:flex; flex-direction:column; justify-content:center; align-items:center;">
                                    <span t-attf-style="color: {{color_pink}}; font-size:11px; margin-bottom:5px; font-weight:bold;">الاستجابة السريع (ZATCA)</span>

                                    <t t-set="final_inv" t-value="False"/>

                                    <t t-if="not is_appointment and 'invoice_ids' in o and o.invoice_ids">
                                        <t t-set="posted_invs" t-value="o.invoice_ids.filtered(lambda i: i.state == 'posted')"/>
                                        <t t-if="posted_invs"><t t-set="final_inv" t-value="posted_invs[0]"/></t>
                                    </t>
                                    <t t-elif="is_appointment">
                                        <t t-if="'invoice_id' in o and o.invoice_id and o.invoice_id.state == 'posted'">
                                            <t t-set="final_inv" t-value="o.invoice_id"/>
                                        </t>
                                        <t t-elif="'invoice_ids' in o and o.invoice_ids">
                                            <t t-set="posted_invs" t-value="o.invoice_ids.filtered(lambda i: i.state == 'posted')"/>
                                            <t t-if="posted_invs"><t t-set="final_inv" t-value="posted_invs[0]"/></t>
                                        </t>
                                    </t>

                                    <t t-set="qr_str" t-value="o.l10n_sa_qr_code_str if 'l10n_sa_qr_code_str' in o and o.l10n_sa_qr_code_str else False"/>
                                    <t t-if="not qr_str and final_inv and 'l10n_sa_qr_code_str' in final_inv and final_inv.l10n_sa_qr_code_str">
                                        <t t-set="qr_str" t-value="final_inv.l10n_sa_qr_code_str"/>
                                    </t>

                                    <t t-set="qr_img" t-value="o.zatca_qr_code if 'zatca_qr_code' in o and o.zatca_qr_code else False"/>
                                    <t t-if="not qr_img and final_inv and 'zatca_qr_code' in final_inv and final_inv.zatca_qr_code">
                                        <t t-set="qr_img" t-value="final_inv.zatca_qr_code"/>
                                    </t>

                                    <t t-if="qr_str">
                                        <img t-att-src="'/report/barcode/QR/%s?width=120&amp;height=120' % qr_str"
                                             alt="ZATCA QR"
                                             style="width:80px;height:80px;border:1px solid #e6e6e6;border-radius:8px;padding:2px;"/>
                                    </t>
                                    <t t-elif="qr_img">
                                        <img t-att-src="'data:image/png;base64,%s' % qr_img"
                                             alt="ZATCA QR Code"
                                             style="width:80px;height:80px;border:1px solid #e6e6e6;border-radius:8px;padding:2px;"/>
                                    </t>
                                    <t t-else="">
                                        <span style="font-size: 9px; color: #999; padding: 10px; border: 1px dashed #ccc; border-radius: 5px; text-align: center;">
                                            <t t-if="not final_inv">لم يتم إصدار<br/>الفاتورة النهائية</t>
                                            <t t-else="">لا يوجد QR</t>
                                        </span>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <div class="text-center" style="margin-top: 30px; padding-top: 15px; border-top: 2px solid #df7b8e; color: #555;">
                            <div style="font-size: 18px; margin-bottom: 5px;">
                                <i class="fa fa-instagram" t-attf-style="color: {{color_pink}}; margin: 0 10px;"></i>
                                <i class="fa fa-snapchat-ghost" t-attf-style="color: {{color_pink}}; margin: 0 10px;"></i>
                                <i class="fa fa-music" t-attf-style="color: {{color_pink}}; margin: 0 10px;"></i>
                            </div>
                            <strong style="font-size: 14px;"><t t-esc="seller_name"/></strong><br/>
                            <a t-attf-href="http://{{ o.company_id.website or 'www.noofbeauty.sa' }}" t-attf-style="color: {{color_pink}}; text-decoration: none;">
                                <t t-esc="o.company_id.website or 'www.noofbeauty.sa'"/>
                            </a>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>