<odoo>
    <data>


        <record id="product_category_form_view_inh" model="ir.ui.view">
            <field name="name">product_category_form_view_inh</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="ar_name"/>
                    <field name="ar_description"/>
                    <field name="description"/>
                    <field name="img" widget="image" class="oe_avatar"/>
                </xpath>

                <!--                <xpath expr="//group[@name='first']" position="after">-->
                <!--                    <notebook>-->
                <!--                        <page string="Images">-->
                <!--                            <field name="img_ids">-->
                <!--                                <tree string="Images" editable="bottom">-->
                <!--                                    <field name="name"/>-->
                <!--                                    <field name="img"/>-->
                <!--                                </tree>-->
                <!--                            </field>-->
                <!--                        </page>-->
                <!--                    </notebook>-->
                <!--                </xpath>-->

            </field>
        </record>

        <record id="product_template_only_form_view_inh" model="ir.ui.view">
            <field name="name">product_template_only_form_view_inh</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//page[@name='general_information']" position="after">
                    <page string="Images">
                        <field name="img_ids">
                            <tree string="Images" editable="bottom">
                                <field name="name"/>
                                <field name="img"  />
                            </tree>
                        </field>
                    </page>
                </xpath>

            </field>
        </record>

        <record id="product_template_img_tree" model="ir.ui.view">
            <field name="name">product.template.img.tree</field>
            <field name="model">product.template.img</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="img" />
                    <field name="img_id"/>
                </tree>
            </field>
        </record>


        <record id="action_product_template_img" model="ir.actions.act_window">
            <field name="name">Product Images</field>
            <field name="res_model">product.template.img</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_product_template_img"
                  name="Product Images"
                  parent="stock.menu_stock_inventory_control"
                  action="action_product_template_img"
                  sequence="90"/>

    </data>
</odoo>