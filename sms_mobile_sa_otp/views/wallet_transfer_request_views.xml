<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wallet_transfer_request_tree" model="ir.ui.view">
            <field name="name">wallet.transfer.request.tree</field>
            <field name="model">wallet.transfer.request</field>
            <field name="arch" type="xml">
                <tree string="Wallet Transfer Requests" decoration-warning="state=='pending'" decoration-info="state=='processing'" decoration-success="state=='completed'" decoration-danger="state=='declined'" decoration-primary="state=='approved'">
                    <field name="sequence"/>
                    <field name="partner_id"/>
                    <field name="transfer_amount" sum="Total Transfer"/>
                    <field name="wallet_balance_at_request"/>
                    <field name="bank_name"/>
                    <field name="account_number"/>
                    <field name="state" widget="badge" decoration-warning="state=='pending'" decoration-info="state=='processing'" decoration-success="state in ('completed', 'approved')" decoration-danger="state=='declined'"/>
                    <field name="requested_at"/>
                    <field name="reviewed_by"/>
                    <field name="bank_transfer_reference"/>
                </tree>
            </field>
        </record>

        <record id="view_wallet_transfer_request_form" model="ir.ui.view">
            <field name="name">wallet.transfer.request.form</field>
            <field name="model">wallet.transfer.request</field>
            <field name="arch" type="xml">
                <form string="Wallet Transfer Request">
                    <header>
                        <button name="action_approve" type="object" string="Approve &amp; Deduct Wallet" class="btn-primary" invisible="state != 'pending'"/>
                        <button name="action_decline" type="object" string="Decline" class="btn-danger" invisible="state not in ('pending', 'approved', 'processing')"/>
                        <button name="action_mark_processing" type="object" string="Mark Processing" class="btn-warning" invisible="state != 'approved'"/>
                        <button name="action_mark_completed" type="object" string="Mark Completed" class="btn-success" invisible="state not in ('approved', 'processing')"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,approved,processing,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(account.action_move_journal_line)d"
                                    type="action"
                                    class="oe_stat_button"
                                    icon="fa-bars"
                                    invisible="not move_id"
                                    context="{'search_default_id': move_id}">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Journal</span>
                                    <span class="o_stat_text">Entry</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="sequence" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Customer Information">
                                <field name="partner_id" readonly="1"/>
                                <field name="wallet_balance_at_request" readonly="1"/>
                                <field name="transfer_amount" readonly="1"/>
                                <field name="currency_id" readonly="1"/>
                            </group>
                            <group string="Accounting &amp; Wallet">
                                <field name="wallet_transaction_id" readonly="1" invisible="not wallet_transaction_id"/>
                                <field name="move_id" readonly="1" invisible="not move_id"/>
                            </group>
                        </group>

                        <group string="Bank Account Details">
                            <group>
                                <field name="bank_name" readonly="1"/>
                                <field name="account_holder_name" readonly="1"/>
                            </group>
                            <group>
                                <field name="account_number" readonly="1"/>
                                <field name="swift_code" readonly="1"/>
                            </group>
                        </group>

                        <group string="Customer Notes" invisible="not reason">
                            <field name="reason" readonly="1" nolabel="1" colspan="2"/>
                        </group>

                        <group string="Admin Response" invisible="state == 'pending'">
                            <group>
                                <field name="reviewed_by" readonly="1"/>
                                <field name="reviewed_at" readonly="1"/>
                                <field name="completed_at" readonly="1" invisible="state != 'completed'"/>
                                <field name="bank_transfer_reference" readonly="1" invisible="state != 'completed'"/>
                            </group>
                            <group invisible="state != 'declined'">
                                <field name="decline_reason" readonly="1"/>
                            </group>
                        </group>

                        <group string="Admin Notes">
                            <field name="admin_notes" nolabel="1" colspan="2" placeholder="Add internal notes here..."/>
                        </group>

                        <group string="Timestamps">
                            <group>
                                <field name="requested_at" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_wallet_transfer_request_search" model="ir.ui.view">
            <field name="name">wallet.transfer.request.search</field>
            <field name="model">wallet.transfer.request</field>
            <field name="arch" type="xml">
                <search string="Search Transfer Requests">
                    <field name="sequence"/>
                    <field name="partner_id"/>
                    <field name="bank_name"/>
                    <field name="account_number"/>
                    <separator/>
                    <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                    <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                    <filter name="filter_processing" string="Processing" domain="[('state', '=', 'processing')]"/>
                    <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                    <filter name="filter_declined" string="Declined" domain="[('state', '=', 'declined')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                        <filter name="group_reviewed_by" string="Reviewed By" context="{'group_by': 'reviewed_by'}"/>
                        <filter name="group_bank" string="Bank" context="{'group_by': 'bank_name'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_wallet_transfer_request_kanban" model="ir.ui.view">
            <field name="name">wallet.transfer.request.kanban</field>
            <field name="model">wallet.transfer.request</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_mobile">
                    <field name="sequence"/>
                    <field name="partner_id"/>
                    <field name="transfer_amount"/>
                    <field name="bank_name"/>
                    <field name="state"/>
                    <field name="decline_reason"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="sequence"/>
                                            </strong>
                                        </div>
                                        <span t-if="record.state.raw_value == 'pending'" class="badge bg-warning">Pending</span>
                                        <span t-if="record.state.raw_value == 'approved'" class="badge bg-primary">Approved</span>
                                        <span t-if="record.state.raw_value == 'processing'" class="badge bg-info">Processing</span>
                                        <span t-if="record.state.raw_value == 'completed'" class="badge bg-success">Completed</span>
                                        <span t-if="record.state.raw_value == 'declined'" class="badge bg-danger">Declined</span>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div><strong>Customer:</strong> <field name="partner_id"/></div>
                                        <div><strong>Amount:</strong> <field name="transfer_amount" widget="monetary"/></div>
                                        <div><strong>Bank:</strong> <field name="bank_name"/></div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_wallet_transfer_decline_wizard_form" model="ir.ui.view">
            <field name="name">wallet.transfer.decline.wizard.form</field>
            <field name="model">wallet.transfer.decline.wizard</field>
            <field name="arch" type="xml">
                <form string="Decline Transfer Request">
                    <group>
                        <field name="transfer_request_id" readonly="1"/>
                        <field name="will_refund" invisible="1"/>
                        <div class="alert alert-warning" role="alert" invisible="not will_refund">
                            <strong>Note:</strong> The wallet amount has already been deducted. Declining will refund the amount back to the customer's wallet.
                        </div>
                        <field name="decline_reason" required="1" placeholder="Please provide a reason for declining this transfer request..."/>
                    </group>
                    <footer>
                        <button name="action_confirm_decline" type="object" string="Confirm Decline" class="btn-danger"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_wallet_transfer_complete_wizard_form" model="ir.ui.view">
            <field name="name">wallet.transfer.complete.wizard.form</field>
            <field name="model">wallet.transfer.complete.wizard</field>
            <field name="arch" type="xml">
                <form string="Complete Transfer Request">
                    <group>
                        <field name="transfer_request_id" readonly="1" invisible="1"/>
                        <field name="bank_transfer_reference" required="1" placeholder="e.g. TR-123456789"/>
                    </group>
                    <group string="Accounting Details">
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="wallet_account_id" options="{'no_create': True}"/>
                    </group>
                    <footer>
                        <button name="action_confirm_complete" type="object" string="Confirm &amp; Post Entry" class="btn-success"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="wallet_transfer_request_action" model="ir.actions.act_window">
            <field name="name">Wallet Transfer Requests</field>
            <field name="res_model">wallet.transfer.request</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="search_view_id" ref="view_wallet_transfer_request_search"/>
            <field name="context">{'search_default_filter_pending': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No wallet transfer requests yet
                </p>
                <p>
                    Transfer requests from customers (wallet to bank) will appear here.
                    You can approve, decline, or mark them as completed.
                </p>
            </field>
        </record>

        <record id="seq_wallet_transfer_request" model="ir.sequence">
            <field name="name">Wallet Transfer Request Sequence</field>
            <field name="code">wallet.transfer.request.sequence</field>
            <field name="prefix">TRF/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <menuitem id="menu_wallet_transfer_requests"
                  name="Wallet Transfer Requests"
                  parent="appointment_management_system.menu_appointment_root"
                  action="wallet_transfer_request_action"
                  sequence="3"/>

    </data>
</odoo>