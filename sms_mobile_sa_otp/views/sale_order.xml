<odoo>
    <data>
<record id="view_order_form_sale_inh" model="ir.ui.view">
        <field name="name">view_order_form_sale_inh</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/tree" position="inside">
                <field name="is_scheduled" optional="hide"/>

            </xpath>

        </field>
    </record>
    </data>
</odoo>
