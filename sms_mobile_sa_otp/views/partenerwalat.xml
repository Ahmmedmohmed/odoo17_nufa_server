<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_wallet_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.wallet.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <field name="currency_id" invisible="1"/>
            </xpath>

            <!-- إظهار الرصيد الإجمالي في الأعلى -->
            <xpath expr="//div[@name='button_box']" position="before">
                <div class="oe_title" style="margin-bottom: 10px;">
                    <label for="wallet_balance" string="إجمالي رصيد المحفظة" style="font-weight: bold; color: #017e84;"/>
                    <h1>
                        <field name="wallet_balance" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                    </h1>
                </div>
            </xpath>

            <!-- إضافة الحقل اليدوي داخل صفحة المبيعات والمشتريات -->
            <xpath expr="//page[@name='sales_purchases']//group[@name='purchase']" position="inside">
                <field name="manual_wallet_balance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>

        </field>
    </record>
</odoo>