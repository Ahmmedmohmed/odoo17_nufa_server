<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_restock_notification" model="mail.template">
            <field name="name">Product Restock Notification</field>
            <field name="model_id" ref="model_product_stock_notification"/>
            <field name="subject">خبر سعيد! منتجك المفضل أصبح متوفراً 🎉</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: 'Cairo', Arial, sans-serif; text-align: center;">
                    <p style="margin: 0px; padding: 0px; font-size: 16px;">
                        مرحباً،
                        <br /><br />
                        لقد طلبت منا إعلامك عندما يتوفر منتج <strong><t t-out="object.product_id.name"/></strong>.
                        <br /><br />
                        المنتج متوفر الآن في المخزون! يمكنك طلبه الآن قبل نفاذ الكمية.
                        <br /><br />
                        <div style="text-align: center; margin-top: 20px;">
                            <img t-attf-src="/web/image/product.product/{{ object.product_id.id }}/image_128" style="width: 150px; border-radius: 8px;"/>
                        </div>
                        <br /><br />
                        شكراً لثقتك بنا!
                    </p>
                </div>
            </field>
        </record>

        <record id="ir_cron_check_restock_notifications" model="ir.cron">
            <field name="name">Check Product Restock Notifications</field>
            <field name="model_id" ref="model_product_stock_notification"/>
            <field name="state">code</field>
            <field name="code">model._check_stock_and_notify()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>