<templates id="template" xml:space="preserve">
    <t t-name="ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('product-content')]" position="before">
            <t t-set="product" t-value="this.env.services.pos.db.get_product_by_id(props.productId)"/>
            <t t-if="this.env.services.pos.config.wk_display_stock and product.type != 'service'">
                <t t-if="product.wk_qty_available > 0">
                    <span class="qty-tag" style="background: green;" t-att-id="'qty-tag'+product.id">
                        <t t-esc="product.wk_qty_available"/>
                    </span>
                </t>
                <t t-elif="product.wk_qty_available == 0">
                    <span class="qty-tag" style="background: gray;" t-att-id="'qty-tag'+product.id">
                        <t t-esc="product.wk_qty_available"/>
                    </span>
                </t>
                <t t-else="">
                    <span class="qty-tag" style="background: red;" t-att-id="'qty-tag'+product.id">
                        <t t-esc="product.wk_qty_available"/>
                    </span>
                </t>
            </t>
        </xpath>
    </t>

    <t t-name="pos_stocks.OutOfStockMessagePopup" owl="1">
        <div class="popup">
            <div class="modal-header">
                <h4 class="modal-title title">
                    <t t-esc=" props.title || 'Message' " class="modal-title"/>
                </h4>
            </div>
            <main class="modal-body">
                <t t-esc="  props.body || '' " />
            </main>
            <div class="footer modal-footer">
                <div class="button cancel btn btn-lg btn-primary " t-on-click="cancel">
                    OK
                </div>
            </div>
        </div>
    </t>
</templates>