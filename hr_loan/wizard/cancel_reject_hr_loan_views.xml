<odoo>
    <data>
        <record id="view_cancel_reject_hr_loan_form" model="ir.ui.view">
            <field name="name">view.cancel.reject.hr.loan.form</field>
            <field name="model">cancel.reject.hr.loan</field>
            <field name="arch" type="xml">
                <form string="Cancel Or Reject HR Loan">
                    <sheet>
                        <group>
                            <field name="reason"/>
                        </group>

                    </sheet>
                    <footer>
                        <button name="action_cancel_reject" string="Save" type="object" class="oe_highlight"/>
                        or
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_cancel_hr_loan_wizard" model="ir.actions.act_window">
            <field name="name">Cancel</field>
            <field name="res_model">cancel.reject.hr.loan</field>
            <field name="view_mode">form</field>
            <field name="context">{"cancel_loan":1}</field>
            <field name="view_id" ref="hr_loan.view_cancel_reject_hr_loan_form"/>
            <field name="target">new</field>
        </record>

        <record id="action_reject_hr_loan_wizard" model="ir.actions.act_window">
            <field name="name">Reject</field>
            <field name="res_model">cancel.reject.hr.loan</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="hr_loan.view_cancel_reject_hr_loan_form"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>

