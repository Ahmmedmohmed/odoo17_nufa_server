<odoo>
    <data noupdate="1">
        <!-- Loans -related subtypes for messaging / Chatter -->
        <record id="mt_hr_loan_validated" model="mail.message.subtype">
            <field name="name">Validated</field>
            <field name="res_model">hr.loan</field>
            <field name="default" eval="True"/>
            <field name="description">Loan has been validated</field>
        </record>
        <record id="mt_hr_loan_confirmed" model="mail.message.subtype">
            <field name="name">Confirmed</field>
            <field name="res_model">hr.loan</field>
            <field name="default" eval="True"/>
            <field name="description">Loan has been confirmed</field>
        </record>
        <record id="mt_hr_loan_approved" model="mail.message.subtype">
            <field name="name">Approved</field>
            <field name="res_model">hr.loan</field>
            <field name="default" eval="True"/>
            <field name="description">Loan has been approved</field>
        </record>
        <record id="mt_hr_loan_rejected" model="mail.message.subtype">
            <field name="name">Rejected</field>
            <field name="res_model">hr.loan</field>
            <field name="default" eval="True"/>
            <field name="description">Loan has been Rejected</field>
        </record>
        <record id="mt_hr_loan_canceled" model="mail.message.subtype">
            <field name="name">Canceled</field>
            <field name="res_model">hr.loan</field>
            <field name="default" eval="True"/>
            <field name="description">Loan has been canceled</field>
        </record>

        <!-- Advances -related subtypes for messaging / Chatter -->
        <record id="mt_hr_advance_validated" model="mail.message.subtype">
            <field name="name">Validated</field>
            <field name="res_model">hr.loan</field>
            <field name="default" eval="True"/>
            <field name="description">Advance has been validated</field>
        </record>
        <record id="mt_hr_advance_confirmed" model="mail.message.subtype">
            <field name="name">Confirmed</field>
            <field name="res_model">hr.loan</field>
            <field name="default" eval="True"/>
            <field name="description">Advance has been confirmed</field>
        </record>
        <record id="mt_hr_advance_approved" model="mail.message.subtype">
            <field name="name">Approved</field>
            <field name="res_model">hr.loan</field>
            <field name="default" eval="True"/>
            <field name="description">Advance has been approved</field>
        </record>
        <record id="mt_hr_advance_rejected" model="mail.message.subtype">
            <field name="name">Rejected</field>
            <field name="res_model">hr.loan</field>
            <field name="default" eval="True"/>
            <field name="description">Advance has been Rejected</field>
        </record>
        <record id="mt_hr_advance_canceled" model="mail.message.subtype">
            <field name="name">Canceled</field>
            <field name="res_model">hr.loan</field>
            <field name="default" eval="True"/>
            <field name="description">Advance has been canceled</field>
        </record>
    </data>
</odoo>