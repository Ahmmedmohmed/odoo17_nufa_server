<odoo>
    <data noupdate="1">
        <record id="sequence_hr_loan" model="ir.sequence">
            <field name="name">HR Loan Request Sequence</field>
            <field name="code">hr.loan</field>
            <field name="prefix">LOAN/</field>
            <field name="padding">4</field>
            <field eval="False" name="company_id"/>
        </record>

        <record id="sequence_hr_advance" model="ir.sequence">
            <field name="name">HR Advance Request Sequence</field>
            <field name="code">hr.advance</field>
            <field name="prefix">ADV/</field>
            <field name="padding">4</field>
            <field eval="False" name="company_id"/>
        </record>
    </data>
</odoo>
