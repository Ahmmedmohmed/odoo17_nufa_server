<?xml version="1.0" encoding="UTF-8"?>

<odoo>
	<data>
    <record model="ir.ui.view" id="view_pos_is_appointment_form_extended">
            <field name="name">pos.order.is_appointment.form.extend</field>
            <field name="model">pos.order</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lines']/tree/field[@name='qty']" position="after">
                    <field name="is_appointment_line" column_invisible="True"/>
                    <field name="appointment_id" optional="hide"/>
                </xpath>

            </field>
        </record>


	</data>
</odoo>
