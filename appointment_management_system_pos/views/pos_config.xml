<?xml version="1.0" encoding="UTF-8"?>

<odoo>
	<data>
		<record model="ir.ui.view" id="pos_config_form_view_inherit_pos_allow_appointment">
      <field name="name">pos.config.form.extended.allow_appointment.view</field>
			<field name="model">res.config.settings</field>
			<field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
				<field name="arch" type="xml">
					<xpath expr="//block[@id='pos_interface_section']" position='inside'>

								<div class="col-xs-12 col-md-6 o_setting_box" >
									<div class="o_setting_left_pane">
										<field name="allow_appointment"/>
									</div>
									<div class="o_setting_right_pane">
											<label for="allow_appointment"/>
											<div class="text-muted">
												Allow Appointments Management System
											</div>

									</div>

								</div>
					</xpath>

				</field>
		</record>


	</data>
</odoo>
