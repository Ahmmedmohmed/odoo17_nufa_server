<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="appointment_management_system_pos.AppointmentPopup">
        <div class="product-selection-combo-popup popup">

            <style>
                /* 🚀 CSS مخصص لتوحيد مقاسات جميع الصور بشكل إجباري */
                .product-selection-combo-popup .products-widget-control img,
                .product-selection-combo-popup .category-button img,
                .product-selection-combo-popup .product-img img {
                    width: 90px !important;      /* عرض ثابت للجميع */
                    height: 90px !important;     /* طول ثابت للجميع */
                    object-fit: contain !important; /* احتواء الصورة دون تشويه */
                    margin: 0 auto !important;
                    display: block !important;
                }

                /* توحيد مقاسات الأزرار (المربعات) الحاوية للصور */
                .product-selection-combo-popup .category-button,
                .product-selection-combo-popup .product {
                    min-width: 110px !important;
                    max-width: 130px !important;
                    display: flex !important;
                    flex-direction: column !important;
                    align-items: center !important;
                    justify-content: start !important;
                    padding: 10px 5px !important;
                    overflow: hidden !important;
                }

                /* ضبط شكل النص تحت الصورة ليكون متوسيطاً ومقروءاً */
                .product-selection-combo-popup .category-button .name,
                .product-selection-combo-popup .product-content .product-name {
                    width: 100% !important;
                    text-align: center !important;
                    margin-top: 8px !important;
                    font-size: 13px !important;
                    white-space: normal !important; /* السماح بنزول النص سطرين */
                    line-height: 1.2 !important;
                }
            </style>

            <div class="modal-header" style="padding: 5px;">
                <h4 class="button cancel btn btn-lg btn-primary" t-on-click="confirm"><t t-esc="props.confirmText"/></h4>
                <h4 class="modal-title"><t t-esc="props.title"/></h4>
                <div class="btn" t-on-click="cancel"><i class="fa fa-times" aria-hidden="true"></i></div>
            </div>

            <header class="modal-header" t-att-data-product_id="main_product_id">
                <div class="container d-flex justify-content-center">
                    <div class="col-6 d-flex justify-content-center">
                        <Input tModel="[state, 'searchWord']" class="'col-12 p-2'" isSmall="ui.isSmall" placeholder="'Search products ...'" icon="{type: 'fa', value: 'fa-search'}" debounceMillis="100" />
                    </div>
                </div>
            </header>

            <main class="body modal-body">
                <div class='selection scrollable-y touch-scrollable selection-height'>
                    <div>
                        <div class="overflow-auto p-3">
                            <div class="d-flex overflow-auto w-100 shadow-sm justify-content-center">
                                <div class="products-widget-control d-flex bg-view justify-content-center" t-att-class="{'h-12': showCategoryImages}">
                                    <t t-set="showCategoryImages" t-value="getShowCategoryImages()"/>
                                    <CategorySelector categories="appointment_categories" onClick="(id) => this.switchCategory(id)" showImage="showCategoryImages" class="ui.isSmall ? 'scrollbar-hidden' : ''"/>
                                </div>
                            </div>

                            <AppointmentSeviceList class="shadow-sm" products="productsToDisplay" orderMenu="OrderMenuToDisplay" onClick="(product) =>this.addProduct(product)" onRemoveClick="(product) =>this.removeProduct(product)"/>

                            <AppointmentSeviceDetails t-if="productsToDisplay.length != 0"
                                class="pos.productViewMode"
                                SelectedServices="SelectedServices"
                                appointmentDetails="pos.appointmentDetails"
                            />
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </t>
</templates>