<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="appointment_management_system_pos.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
		    <xpath expr="//Orderline" position="inside" >
          <ul t-if="line.appointmentInfo">
              <li> <t t-esc="line.appointmentInfo.appointment_name"/>  </li>
              <li> <t t-esc="line.appointmentInfo.employee_name"/>  </li>
              <li> <t t-esc="line.appointmentInfo.branch_name"/>  </li>
              <li> <t t-esc="line.appointmentInfo.appointment_type"/>  </li>
              <li> <t t-esc="line.appointmentInfo.date"/>-<t t-esc="line.appointmentInfo.slot_name"/></li>
          </ul>
        </xpath>

    </t>
</templates>
