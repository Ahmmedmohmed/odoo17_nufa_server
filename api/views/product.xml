<odoo>
    <data>

        <record id="product_template_form_view_inherit" model="ir.ui.view">
            <field name="name">product_template_form_view_inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <label for="ar_name"/>
                    <field name="ar_name"/>
                    <label for="ar_description"/>
                    <field name="ar_description"/>

                    <label for="avg_rating"/>
                    <field name="avg_rating"/>

                    <label for="top"/>
                    <field name="top"/>
                </xpath>

                <xpath expr="//div[@name='options']" position="inside">
                    <span class="d-inline-flex">
                        <field name="is_appointment_service"/>
                        <label for="is_appointment_service"/>
                    </span>
                </xpath>

                <xpath expr="//field[@name='list_price']" position="after">
                    <label for="price_after_discount"/>

                    <field name="price_after_discount"/>
                </xpath>

            </field>
        </record>


        <record id="product_product_form_view_inherit" model="ir.ui.view">
            <field name="name">product_product_form_view_inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <label for="ar_name"/>
                    <field name="ar_name"/>
                    <label for="ar_description"/>
                    <field name="ar_description"/>

                    <label for="avg_rating"/>
                    <field name="avg_rating"/>

                    <label for="top"/>
                    <field name="top"/>
                </xpath>



                <xpath expr="//field[@name='list_price']" position="after">
                    <label for="price_after_discount"/>

                    <field name="price_after_discount"/>
                </xpath>

            </field>
        </record>


    </data>
</odoo>