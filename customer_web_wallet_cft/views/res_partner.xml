<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="customer_web_wallet_res_partner_view_form" model="ir.ui.view">
        <field name="name">customer.web.wallet.res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='container_row_2']/group[3]" position="after">
                <group string="Available Wallet Balance" name="available_balance">
                    <field name="available_balance"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>