<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="wallet_acquirer" model="payment.acquirer">
        <field name="name">Wallet </field>
        <field name="sequence">2</field>
        <field name="state">enabled</field>
        <field name="view_template_id" ref="payment.default_acquirer_button"/>
        <field name="wallet_acquirer" eval="True"/>
        <field name="image_128" type="base64"
               file="customer_web_wallet_cft/static/src/img/wallet_icon.png"/>
        <field name="module_id" ref="base.module_payment_transfer"/>
        <field name="pending_msg">&lt;i&gt;Pending&lt;/i&gt;... The order will
            be validated after the payment.
        </field>
    </record>
</odoo>