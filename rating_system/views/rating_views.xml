<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_rating_tree" model="ir.ui.view">
        <field name="name">service.rating.tree</field>
        <field name="model">service.rating</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not is_approved" decoration-success="is_approved" editable="bottom">
                <field name="partner_id" readonly="1"/>
                <field name="product_id" readonly="1"/>
                <field name="employee_id" readonly="1"/>
                <field name="rating_float"/>
                <field name="comment" readonly="1"/>
                <field name="is_approved" string="Approve/Show"/>
            </tree>
        </field>
    </record>

    <record id="action_service_rating" model="ir.actions.act_window">
        <field name="name">Customer Ratings</field>
        <field name="res_model">service.rating</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_rating_main" name="Ratings" parent="stock.menu_stock_root" sequence="50"/>
    <menuitem id="menu_rating_list" name="Reviews Approval" parent="menu_rating_main" action="action_service_rating"/>
</odoo>