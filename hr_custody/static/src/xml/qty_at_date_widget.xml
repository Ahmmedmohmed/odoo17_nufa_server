<templates>
    <div t-name="hr_custody.QtyDetailPopOver">
        <table class="table table-borderless table-sm">
            <tr>
                <td>
                    <strong>Forecasted Stock</strong>
                </td>
                <td>
                    <b t-esc='data.virtual_available_at_date'/>
                    <t t-esc='data.uom_id.data.display_name'/>
                </td>
            </tr>
            <tr>
                <td>
                    <strong>Available</strong>
                </td>
                <td>
                    <b t-esc='data.free_qty_today' t-att-class="!data.will_be_fulfilled ? 'text-danger': ''"/>
                    <t t-esc='data.uom_id.data.display_name'/>
                </td>
            </tr>
        </table>
        <button class="text-left btn btn-link action_open_forecast" type="button">
            <i class="fa fa-fw o_button_icon fa-arrow-right"></i>View Forecast
        </button>
    </div>
</templates>