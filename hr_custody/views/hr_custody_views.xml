<odoo>
    <!--Custody Lines -->
    <record id="view_hr_custody_line_filter" model="ir.ui.view">
        <field name="name">view.hr.custody.line.filter</field>
        <field name="model">hr.custody.line</field>
        <field name="arch" type="xml">
            <search string="HR Custodies Lines">
                <field name="name"/>
                <field name="custody_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="reason"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="manager_id"/>
                <field name="user_id"/>

                <group expand="0" string="Group By">
                    <filter string="Custody" name="custody_id" domain="[]" context="{'group_by':'custody_id'}"/>
                    <filter string="Product" name="product_id" domain="[]" context="{'group_by':'product_id'}"/>
                    <separator/>
                    <filter string="Employee" name="employee_id" domain="[]" context="{'group_by':'employee_id'}"/>
                    <filter string="Department" name="department_id" domain="[]"
                            context="{'group_by':'department_id'}"/>
                    <filter string="Manager" name="manager_id" domain="[]" context="{'group_by':'manager_id'}"/>
                    <filter string="Job" name="job_id" domain="[]" context="{'group_by':'job_id'}"/>
                    <filter string="Assigned To" name="group_by_user_id" domain="[]" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_hr_custody_line_disbursement_readonly_tree" model="ir.ui.view">
        <field name="name">view.hr.custody.line.disbursement.readonly.tree</field>
        <field name="model">hr.custody.line</field>
        <field name="arch" type="xml">
            <tree string="HR Custodies Lines" create="0" edit="0" delete="0" editable="bottom">
                <header>
                    <button name="action_disbursement" type="object" string="Disbursement"/>
                </header>

                <field name="custody_id" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="department_id" optional="hide"/>
                <field name="manager_id" optional="hide"/>
                <field name="job_id" optional="hide"/>
                <field name="name" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="quantity" optional="show"/>
                <field name="uom_id" optional="hide"/>
                <field name="reason" optional="hide"/>
                <field name="user_id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_custody_line_return_readonly_tree" model="ir.ui.view">
        <field name="name">view.hr.custody.line.return.readonly.tree</field>
        <field name="model">hr.custody.line</field>
        <field name="arch" type="xml">
            <tree string="HR Custodies Lines" create="0" edit="0" delete="0" editable="bottom">
                <field name="custody_id" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="department_id" optional="hide"/>
                <field name="manager_id" optional="hide"/>
                <field name="job_id" optional="hide"/>
                <field name="name" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="quantity" optional="show"/>
                <field name="uom_id" optional="hide"/>
                <field name="reason" optional="hide"/>
                <field name="user_id" optional="show"/>

                <button name="action_get_picking" type="object" icon="fa-truck"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_custody_line_form" model="ir.ui.view">
        <field name="name">view.hr.custody.line.form</field>
        <field name="model">hr.custody.line</field>
        <field name="arch" type="xml">
            <form string="HR Custody Lines">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id" options="{'no_create': True, 'no_open': True}"
                                   invisible="done_state != 'approve'"/>
                            <field name="done_state" invisible="1"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="reason"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Custodies -->
    <record id="view_hr_custody_filter" model="ir.ui.view">
        <field name="name">view.hr.custody.filter</field>
        <field name="model">hr.custody</field>
        <field name="arch" type="xml">
            <search string="HR Custodies">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="manager_id"/>
                <field name="user_id"/>
                <field name="received_date"/>
                <field name="description"/>

                <filter string="Date" name="date" date="date"/>
                <filter string="Received Date" name="received_date" date="received_date"/>

                <group expand="0" string="Group By">
                    <filter string="Employee" name="employee_id" domain="[]" context="{'group_by':'employee_id'}"/>
                    <filter string="Department" name="department_id" domain="[]"
                            context="{'group_by':'department_id'}"/>
                    <filter string="Manager" name="manager_id" domain="[]" context="{'group_by':'manager_id'}"/>
                    <filter string="Job" name="job_id" domain="[]" context="{'group_by':'job_id'}"/>
                    <filter string="Assigned To" name="group_by_user_id" domain="[]" context="{'group_by': 'user_id'}"/>
                    <separator/>
                    <filter name="group_by_received_date" string="Received Date" domain="[]"
                            context="{'group_by':'received_date'}"/>
                    <filter string="Date" name="group_by_date" domain="[]" context="{'group_by': 'date'}"/>
                    <separator/>
                    <filter name="group_by_state" string="Status" domain="[]" context="{'group_by':'state'}"/>
                    <filter name="group_by_done_state" string="Done Status" domain="[]"
                            context="{'group_by':'done_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_hr_custody_tree" model="ir.ui.view">
        <field name="name">view.hr.custody.tree</field>
        <field name="model">hr.custody</field>
        <field name="arch" type="xml">
            <tree string="HR Custodies">
                <field name="name"/>
                <field name="date" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="department_id" optional="hide"/>
                <field name="manager_id" optional="hide"/>
                <field name="job_id" optional="hide"/>
                <field name="received_date" optional="show"/>
                <field name="full_return" optional="hide"/>
                <field name="user_id" optional="show"/>
                <field name="state" optional="show"/>
                <field name="done_state" decoration-success="done_state == 'approve'"
                       decoration-info="done_state == 'reject'" widget="badge" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_custody_form" model="ir.ui.view">
        <field name="name">view.hr.custody.form</field>
        <field name="model">hr.custody</field>
        <field name="arch" type="xml">
            <form string="HR Custodies">
                <header>
                    <button name="action_validate" type="object" invisible="state != 'draft'" string="Validate" class="btn-primary"
                            groups="hr_custody.group_hr_custody_user"/>
                    <button name="action_confirm" type="object" invisible="state != 'validate'" string="Confirm" class="btn-primary"
                            groups="hr_custody.group_hr_custody_user"/>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="state != 'in_progress'" groups="hr_custody.group_hr_custody_user"/>
                    <button name="%(hr_custody.action_reject_hr_custody_wizard)d" type="action" string="Reject"
                            invisible="state != 'in_progress'" groups="hr_custody.group_hr_custody_user"/>
                    <button name="%(hr_custody.action_cancel_hr_custody_wizard)d" type="action" string="Cancel"
                            invisible="state not in ['draft','validate','in_progress']" groups="hr_custody.group_hr_custody_user"/>
                    <button name="action_send_email" type="object" string="Send Email" class="btn-primary"/>
                    <button name="%(sms.sms_composer_action_form)d" type="action" string="Send SMS"
                            class="btn-primary"/>
                    <field  name="state" widget="statusbar" statusbar_visible="draft,validate,in_progress,done,cancel"/>
                </header>

                <sheet>
                    <field name="done_state" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_get_pickings"
                                icon="fa-truck" invisible="pickings_count == 0">
                            <field string="Delivery" name="pickings_count" widget="statinfo"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Draft" bg_color="bg-danger"
                            invisible="id == False or state != 'draft'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-secondary"
                            invisible="state != 'cancel'"/>
                    <widget name="web_ribbon" title="Approved" bg_color="bg-info"
                            invisible="done_state != 'approve' or full_return"/>
                    <widget name="web_ribbon" title="Returned" bg_color="bg-success"
                            invisible="full_return == False"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="bg-secondary"
                            invisible="done_state != 'reject'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="employee_id" options="{'no_open':True,'no_create':True}" groups="hr_custody.group_hr_custody_user" readonly="state != 'draft'"/>
                            <field name="department_id" options="{'no_open':True,'no_create':True}"/>
                            <field name="manager_id" options="{'no_open':True,'no_create':True}"/>
                            <field name="job_id" options="{'no_open':True,'no_create':True}"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True, 'no_open': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="received_date" readonly="state != 'draft'"/>
                            <field name="full_return" areadonly="state != 'draft'" invisible="1" />
                            <field name="user_id" options="{'no_create': True, 'no_open': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group>
                        <field name="description" readonly="state != 'draft'"/>
                        <field name="reject_reason" readonly="done_state != 'reject'"/>
                        <field name="cancel_reason" invisible="state != 'cancel'"/>
                    </group>

                    <notebook>
                        <page string="Information" name="information">
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree string="Lines" editable="bottom">
                                    <field name="product_id"
                                           column_invisible="('parent.done_state', '!=', 'approve')"/>
                                    <field name="name" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="product_type" invisible="1"/>
                                    <field name="virtual_available_at_date" invisible="1"/>
                                    <field name="qty_available_today" invisible="1"/>
                                    <field name="free_qty_today" invisible="1" optional="hide"/>
                                    <field name="scheduled_date" invisible="1" optional="hide"/>
                                    <field name="qty_to_deliver" invisible="1" optional="hide"/>
                                    <field name="display_qty_widget" invisible="1" optional="hide"/>
                                    <field name="custody_qty_widget" invisible="1" optional="hide"/>

                                    <widget name="qty_at_date_widget" width="20px"/>
                                    <field name="uom_id" options="{'no_create': True, 'no_open': True}"
                                           optional="show"/>
                                    <field name="reason" optional="hide"/>
                                    <field name="stock_picking_id" invisible="1" optional="hide"/>
                                    <field name="done_state" invisible="1" optional="hide"/>
                                    <field name="inventory_state" optional="hide"/>

                                    <button name="action_disbursement" type="object" icon="fa-truck"
                                            invisible="done_state != 'approve' or inventory_state != False"
                                            groups="hr_custody.group_hr_custody_user"/>
                                    <button name="action_get_picking" type="object" icon="fa-truck"
                                            invisible="stock_picking_id == False"
                                            groups="hr_custody.group_hr_custody_user"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hr_custody_graph" model="ir.ui.view">
        <field name="name">view.hr.custody.graph</field>
        <field name="model">hr.custody</field>
        <field name="arch" type="xml">
            <graph string="HR Custodies">
                <field name="employee_id" type="row"/>
                <field name="state" type="col"/>
                <field name="done_state" type="col"/>
            </graph>
        </field>
    </record>
    <record id="view_hr_custody_pivot" model="ir.ui.view">
        <field name="name">view.hr.custody.pivot</field>
        <field name="model">hr.custody</field>
        <field name="arch" type="xml">
            <pivot string="HR Custodies">
                <field name="employee_id" type="row"/>
                <field name="state" type="col"/>
                <field name="done_state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_hr_custody_activity" model="ir.ui.view">
        <field name="name">view.hr.custody.activity</field>
        <field name="model">hr.custody</field>
        <field name="arch" type="xml">
            <activity string="HR Custodies">
                <field name="employee_id"/>
                <templates>
                    <div t-name="activity-box">
                        <img t-att-src="activity_image('hr.employee', 'image_128', record.employee_id.raw_value)"
                             t-att-title="record.employee_id.value" t-att-alt="record.employee_id.value"/>
                        <div>
                            <field name="name" display="full"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id="action_hr_custodies" model="ir.actions.act_window">
        <field name="name">Custodies</field>
        <field name="res_model">hr.custody</field>
        <field name="view_mode">tree,form,pivot,graph,activity</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Custody
            </p>
        </field>
    </record>

    <record id="action_hr_custody_lines_to_disbursement" model="ir.actions.act_window">
        <field name="name">To Disbursement</field>
        <field name="res_model">hr.custody.line</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('done_state','=','approve'),("inventory_state","=",False)]</field>
        <field name="view_id" ref="hr_custody.view_hr_custody_line_disbursement_readonly_tree"/>
    </record>
    <record id="action_hr_custody_lines_to_return" model="ir.actions.act_window">
        <field name="name">To Return</field>
        <field name="res_model">hr.custody.line</field>
        <field name="view_mode">tree</field>
        <field name="domain">
            [('done_state','=','approve'),("inventory_state","!=",False),("full_return","=",False)]
        </field>
        <field name="view_id" ref="hr_custody.view_hr_custody_line_return_readonly_tree"/>
    </record>
    <!-- Inherit Form View to Modify it -->
    <record id="stock_picking_custom" model="ir.ui.view">
        <field name="name">stock.picking.custom</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='origin']" position="after">
                <field name="employee_id"/>
            </xpath>

        </field>
    </record>
</odoo>