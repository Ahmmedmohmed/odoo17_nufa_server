<odoo>
    <record id="view_hr_custody_settings_form" model="ir.ui.view">
        <field name="name">view.hr.custody.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']" position="inside">
                        <block name="hr_custody">
                            <setting help="allow employee to select Operation Type when disbursement products from custodies" title="Operation Type when disbursement products from custodies">

                                    <field name="custody_picking_type_id" options="{'no_create': True, 'no_open': True}"/>

                            </setting>
                        </block>
                </xpath>
        </field>
    </record>
    
</odoo>