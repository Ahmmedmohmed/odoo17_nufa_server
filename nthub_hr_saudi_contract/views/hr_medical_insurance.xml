<odoo>
    <data>
        <record model="ir.ui.view" id="view_hr_medical_insurance_form">
            <field name="name">view.hr.medical.insurance.form</field>
            <field name="model">hr.medical.insurance</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="amount"/>
                            </group>
                            <group>

                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="view_hr_medical_insurance_tree">
            <field name="name">hr.medical.insurance.tree</field>
            <field name="model">hr.medical.insurance</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="amount"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_medical_insurance">
            <field name="name"> Medical Insurance</field>
            <field name="res_model">hr.medical.insurance</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem name="Medical Insurance" id="menu_medical" parent="hr.menu_config_employee"
                  action="action_medical_insurance" sequence="0"/>

    </data>
</odoo>