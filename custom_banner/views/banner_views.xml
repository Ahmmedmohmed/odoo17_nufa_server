<odoo>
    <record id="view_custom_banner_tree" model="ir.ui.view">
        <field name="name">custom.banner.tree</field>
        <field name="model">custom.banner</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="external_url"/>
            </tree>
        </field>
    </record>

    <record id="view_custom_banner_form" model="ir.ui.view">
        <field name="name">custom.banner.form</field>
        <field name="model">custom.banner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="image" widget="image"/>
                        <field name="description"/>
                        <field name="external_url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>