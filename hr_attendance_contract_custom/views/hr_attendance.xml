<odoo>
    <data>
        <record id="hr_attendance_custom_view_tree" model="ir.ui.view">
            <field name="name">hr.attendance.custom.view.tree</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='overtime_hours']" position="replace">
                    <field name="over_time" widget="float_time" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='over_time']" position="after">
                    <field name="act_late_in" widget="float_time" optional="show"/>
                    <field name="act_diff_time" widget="float_time" optional="show"/>
                    <field name="late_in" optional="hide"/>
                    <field name="diff_time" optional="hide"/>
                    <field name="is_tamper" optional="show"/>
                    <field name="is_weekend" optional="show"/>
                    <field name="is_public_holiday" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="hr_attendance_custom_view_form" model="ir.ui.view">
            <field name="name">hr.attendance.custom.view.form</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='overtime_hours']" position="replace">
                    <field name="over_time" widget="float_time"/>
                </xpath>
                <xpath expr="//field[@name='over_time']" position="after">
                    <field name="act_late_in" widget="float_time"/>
                    <field name="act_diff_time" widget="float_time"/>
                    <field name="late_in"/>
                    <field name="diff_time"/>
                </xpath>
                <xpath expr="//field[@name='employee_id']" position="after">
                    <field name="att_date" required="1"/>
                </xpath>
                <xpath expr="//field[@name='check_out']" position="after">
                    <field name="is_tamper"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
