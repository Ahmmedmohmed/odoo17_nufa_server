<odoo>
    <data>
        <!-- 1. تغيير الـ ID بالكامل لنسف تأثير الـ noupdate القديم وإجبار أودو على التطبيق -->
        <record id="strict_appointment_branch_rule_v2" model="ir.rule">
            <field name="name">Strict Appointment Branch Separation</field>
            <field name="model_id" ref="model_appointment_management"/>
            <!-- الفلترة المباشرة والصارمة على الفرع الفعلي -->
            <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id', 'in', company_ids)]</field>
            <!-- تطبيق القاعدة إجبارياً على جميع المستخدمين الداخليين -->
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 2. قاعدة صارمة لفواتير المبيعات -->
        <record id="strict_sale_order_branch_rule_v2" model="ir.rule">
            <field name="name">Strict Sale Order Branch Separation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 3. قاعدة صارمة للحسابات والقيود -->
        <record id="strict_account_move_branch_rule_v2" model="ir.rule">
            <field name="name">Strict Invoice Branch Separation</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>