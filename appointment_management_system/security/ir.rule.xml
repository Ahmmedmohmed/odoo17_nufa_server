<odoo>
    <data noupdate="1">
        <!-- قاعدة فصل الحجوزات حسب الفرع الفعلي (branch_id) وليس company_id التقني -->
        <record id="appointment_management_comp_rule" model="ir.rule">
            <field name="name">Appointment Management - Branch Separation</field>
            <field name="model_id" ref="model_appointment_management"/>
            <field name="domain_force">[('branch_id', 'in', company_ids)]</field>
        </record>

        <!-- قاعدة فصل فواتير المبيعات المرتبطة بالحجوزات حسب الفرع -->
        <record id="sale_order_branch_rule" model="ir.rule">
            <field name="name">Sale Order - Branch Separation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- قاعدة فصل فواتير المحاسبة المرتبطة بالحجوزات حسب الفرع -->
        <record id="account_move_branch_rule" model="ir.rule">
            <field name="name">Invoice - Branch Separation</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>