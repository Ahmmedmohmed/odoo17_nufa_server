<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_template_form_appointment_inherit" model="ir.ui.view">
            <field name="name">view.product.template.form.appointment.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='options']" position="inside">
                    <span class="d-inline-flex">
                        <field name="is_appointment_service"/>
                        <label for="is_appointment_service"/>
                    </span>
                </xpath>
                
                <xpath expr="//notebook" position="inside">
                    <page string="Appointment Configuration" invisible="is_appointment_service == False">
                        <field name="plan_ids">
                            <tree editable="top">
                                <field name="employee_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="branch_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="service_duration_inside" widget="float_time"/>
                                <field name="service_duration_outside" widget="float_time"/>
                                <field name="service_price_inside"/>
                                <field name="service_price_outside"/>

                                <field name="currency_id" readonly="1" column_invisible="1"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
        

        <record id="appointment_service_action" model="ir.actions.act_window">
            <field name="name">Appointment Service</field>
            <field name="res_model">product.template</field>
            <field name="domain">[('is_appointment_service', '=', 1)]</field>
            <field name="context">{'default_is_appointment_service': 1}</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
