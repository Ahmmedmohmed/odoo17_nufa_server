        <record id="view_appointment_management_form" model="ir.ui.view">
            <field name="name">view.appointment.management.form</field>
            <field name="model">appointment.management</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="sequence"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="company_id"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="branch_id" domain="[('parent_id', '=', company_id)]" options="{'no_create': True, 'no_create_edit':True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Services">
                                <field name="services_line_ids">
                                    <tree editable="top">
                                        <field name="product_id" width="30%" options="{'no_create': True, 'no_create_edit':True}"/>
                                        <field name="employee_id" width="30%" options="{'no_create': True, 'no_create_edit':True}"/>
                                        <field name="quantity" width="20%"/>
                                        <field name="price_unit" width="20%"/>
                                        <field name="service_rate" width="20%" widget="priority"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="appointment_management_action" model="ir.actions.act_window">
            <field name="name">Appointments</field>
            <field name="res_model">appointment.management</field>
            <field name="view_mode">tree,form</field>
            <field name="target">current</field>
        </record>
    </data>
</odoo>
