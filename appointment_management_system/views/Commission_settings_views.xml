<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- شاشة مستقلة لإعدادات العمولات -->
    <record id="appointment_commission_settings_view" model="ir.ui.view">
        <field name="name">appointment.commission.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="110"/>
        <field name="arch" type="xml">
            <form string="Commission Settings" class="oe_form_configuration">
                <header>
                    <button string="حفظ" type="object" name="execute" class="oe_highlight" data-hotkey="q"/>
                    <button string="إلغاء" type="object" name="cancel" special="cancel" data-hotkey="x"/>
                </header>
                <sheet>
                    <group>
                        <group string="إعدادات العمولات (Commissions Configuration)">
                            <field name="commission_calc_mode" widget="radio" string="طريقة الحساب"/>

                            <!-- 🚀 قائمة القوالب الجاهزة 🚀 -->
                            <field name="formula_template"
                                   widget="selection"
                                   invisible="commission_calc_mode != 'formula'"/>

                            <field name="commission_formula"
                                   class="w-100 fs-5 text-primary fw-bold"
                                   invisible="commission_calc_mode != 'formula'"
                                   required="commission_calc_mode == 'formula'"
                                   placeholder="(price - cost) * (percentage / 100.0)"
                                   string="المعادلة"/>
                        </group>
                    </group>

                    <div class="alert alert-info mt-3" role="alert" invisible="commission_calc_mode != 'formula'">
                        <h4 class="alert-heading">المتغيرات المتاحة للاستخدام:</h4>
                        <p class="mb-2">يمكنك بناء معادلتك الخاصة باستخدام هذه الكلمات (البلوكات):</p>
                        <ul class="list-unstyled ms-3">
                            <li class="mb-2"><span class="badge text-bg-primary fs-6 me-2" style="min-width: 100px;">price</span> = سعر الخدمة المدفوع</li>
                            <li class="mb-2"><span class="badge text-bg-danger fs-6 me-2" style="min-width: 100px;">cost</span> = تكلفة المنتجات والأدوات المستخدمة</li>
                            <li class="mb-2"><span class="badge text-bg-success fs-6 me-2" style="min-width: 100px;">percentage</span> = نسبة الموظف على هذه الخدمة</li>
                        </ul>
                        <hr/>
                        <p class="mb-0"><strong>ملاحظة:</strong> يتم قسمة النسبة دائماً على 100 في المعادلات (مثال: <code>percentage / 100.0</code>).</p>
                    </div>

                    <div class="alert alert-secondary mt-3" role="alert" invisible="commission_calc_mode != 'service'">
                        <strong>طريقة حساب نسبة كل خدمة:</strong><br/>
                        العمولة = سعر الخدمة × النسبة المسجلة للموظف على الخدمة (تاب Service Commissions في كارت الموظف).<br/>
                        لو مفيش نسبة للموظف على الخدمة = مفيش عمولة.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- الأكشن الخاص بالشاشة -->
    <record id="appointment_commission_settings_action" model="ir.actions.act_window">
        <field name="name">Commission Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="appointment_commission_settings_view"/>
        <field name="target">inline</field>
    </record>

    <!-- قائمة منفصلة لإعدادات العمولات تحت قسم الـ Configuration -->
    <menuitem id="menu_appointment_commission_settings"
              name="Commission Settings"
              parent="menu_appointment_configuration"
              action="appointment_commission_settings_action"
              sequence="110"/>
</odoo>