<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_department_form_appointment_inherit" model="ir.ui.view">
            <field name="name">view.hr.department.form.appointment.inherit</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <header>
                        <field name="is_appointment_department" invisible="1"/>
                        <field name="is_times_confirmed" invisible="1"/>

                        <button name="action_available_in_appointment" string="Available In Appointment" type="object" invisible="is_appointment_department" class="btn btn-success"/>
                        <button name="action_unavailable_in_appointment" string="Unavailable In Appointment" type="object" invisible="not is_appointment_department" class="btn btn-danger"/>
                        <button name="action_confirm_times" string="Confirm Appointment Times" type="object" invisible="is_times_confirmed" class="btn btn-success"/>
                    </header>
                </xpath>

                
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="Appointment Time Configuration" invisible="not is_appointment_department">
                            <field name="plan_ids">
                                <tree editable="top">
                                    <field name="day" width="40%"/>
                                    <field name="start_hour" width="15%"/>
                                    <field name="start_minute" width="15%"/>
                                    <field name="end_hour" width="15%"/>
                                    <field name="end_minute" width="15%"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>


        <record id="appointment_department_action" model="ir.actions.act_window">
            <field name="name">Appointment Department</field>
            <field name="res_model">hr.department</field>
            <field name="domain">[('is_appointment_department', '=', 1)]</field>
            <field name="context">{'default_is_appointment_department': 1}</field>
            <field name="view_mode">kanban,tree,hierarchy,form</field>
        </record>
    </data>
</odoo>