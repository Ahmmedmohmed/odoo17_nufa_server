<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- شاشة اختيار الفترة -->
    <record id="appointment_employee_report_wizard_form" model="ir.ui.view">
        <field name="name">appointment.employee.report.wizard.form</field>
        <field name="model">appointment.employee.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="branch_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="employee_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="show_empty"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate Report"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="appointment_employee_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Employee Report</field>
        <field name="res_model">appointment.employee.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- جدول التقرير -->
    <record id="appointment_employee_report_line_tree" model="ir.ui.view">
        <field name="name">appointment.employee.report.line.tree</field>
        <field name="model">appointment.employee.report.line</field>
        <field name="arch" type="xml">
            <tree string="Employee Report" create="0" edit="0" delete="0">
                <field name="employee_id"/>
                <field name="services_count" sum="Total"/>
                <field name="products_sales" sum="Total"/>
                <field name="inside_revenue" sum="Total"/>
                <field name="outside_revenue" sum="Total"/>
                <field name="total_revenue" sum="Total" optional="hide"/>
                <field name="services_cost" sum="Total"/>
                <field name="products_cost" sum="Total"/>
                <field name="total_expenses" sum="Total"/>
                <field name="commission_calc" sum="Total"/>
                <field name="commission_posted" sum="Total" optional="hide"/>
                <field name="net_profit" sum="Total"/>
            </tree>
        </field>
    </record>

    <!-- القوائم -->
    <menuitem id="menu_appointment_reports" name="Reports"
              parent="menu_appointment_root" sequence="8"/>
    <menuitem id="menu_appointment_employee_report" name="Employee Report"
              parent="menu_appointment_reports"
              action="appointment_employee_report_wizard_action" sequence="1"/>

</odoo>