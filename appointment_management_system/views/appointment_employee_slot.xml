<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_appointment_employee_slot_tree" model="ir.ui.view">
            <field name="name">view.appointment.employee.slot.tree</field>
            <field name="model">appointment.employee.slot</field>
            <field name="arch" type="xml">
                <tree editable="top" create="0" edit="0">
                    <field name="name" width="25%"/>
                    <field name="employee_id" width="25%"/>
                    <field name="date" width="20%"/>
                    <field name="time" width="20%"/>
                    <field name="state" width="10%"/>
                </tree>
            </field>
        </record>


        <record id="appointment_employee_slot_action" model="ir.actions.act_window">
            <field name="name">Appointment Employee Slot</field>
            <field name="res_model">appointment.employee.slot</field>
            <field name="view_mode">tree</field>
        </record>
    </data>
</odoo>
