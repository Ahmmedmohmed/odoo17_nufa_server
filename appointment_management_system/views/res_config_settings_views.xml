<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="appointment_simple_settings_view" model="ir.ui.view">
        <field name="name">appointment.simple.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <form string="Appointment Settings" class="oe_form_configuration">
                <header>
                    <button string="Save" type="object" name="execute" class="oe_highlight"/>
                    <button string="Cancel" type="object" name="cancel" special="cancel"/>
                </header>
                <sheet>
                    <group>
                        <group string="Automatic Cart Cancellation">
                            <field name="slot_wait_time" string="Pending Reservation Timeout (Minutes)"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="appointment_simple_settings_action" model="ir.actions.act_window">
        <field name="name">Appointment Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="appointment_simple_settings_view"/>
        <field name="target">inline</field>
    </record>

    <menuitem id="menu_appointment_settings"
              name="Cart Timeout"
              parent="menu_appointment_configuration"
              action="appointment_simple_settings_action"
              sequence="100"/>
</odoo>