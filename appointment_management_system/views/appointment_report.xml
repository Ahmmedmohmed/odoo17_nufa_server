<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_thermal_receipt" model="report.paperformat">
        <field name="name">Thermal Receipt 80mm</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">0</field>
        <field name="page_width">80</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_appointment_receipt" model="ir.actions.report">
        <field name="name">Appointment Receipt</field>
        <field name="model">appointment.management</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">appointment_management_system.report_receipt_template</field>
        <field name="report_file">appointment_management_system.report_receipt_template</field>
        <field name="paperformat_id" ref="appointment_management_system.paperformat_thermal_receipt"/>
        <field name="print_report_name">'Receipt - %s' % (object.appointment_ref)</field>
        <field name="binding_model_id" ref="appointment_management_system.model_appointment_management"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_receipt_template">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">

                <t t-set="color_pink" t-value="'#df7b8e'"/>
                <t t-set="color_light_pink" t-value="'#fdf5f6'"/>
                <t t-set="color_border" t-value="'#e6e6e6'"/>

                <div class="page" style="font-family: 'Cairo', 'Tajawal', 'Arial', sans-serif; direction: rtl; text-align: right; color: #333; font-size: 11px; width: 100%; max-width: 300px; margin: 0 auto; padding: 0;">

                    <div style="text-align: center; margin-bottom: 12px; border-bottom: 2px solid #df7b8e; padding-bottom: 10px;">
                        <h2 style="font-weight: 900; margin: 0 0 5px 0; font-size: 20px; color: #df7b8e;">صالونات نوف</h2>

                        <div style="display: inline-block; background-color: #fdf5f6; padding: 4px 12px; border-radius: 6px; border: 1px solid #df7b8e;">
                            <strong style="font-size: 12px; color: #333;">إيصال حجز (<t t-esc="o.with_context(lang='ar_001').employee_id.name"/>)</strong>
                        </div>
                    </div>

                    <t t-set="pos_line" t-value="o.env['pos.order.line'].sudo().search([('appointment_id', '=', o.id)], limit=1)"/>
                    <t t-if="not pos_line">
                        <t t-set="pos_line" t-value="o.env['pos.order.line'].sudo().search([
                            ('order_id.partner_id', '=', o.partner_id.id),
                            ('product_id', '=', o.product_id.id),
                            ('order_id.state', '=', 'draft')
                        ], order='create_date desc', limit=1)"/>
                        <t t-if="pos_line">
                            <t t-set="dummy" t-value="pos_line.write({'appointment_id': o.id})"/>
                        </t>
                    </t>
                    <t t-set="pos_order" t-value="pos_line.order_id if pos_line else False"/>
                    <t t-set="taxes" t-value="o.product_id.taxes_id.compute_all(o.price_unit, o.currency_id, 1, product=o.product_id, partner=o.partner_id) if o.product_id and o.currency_id else {'total_included': 0, 'total_excluded': 0}"/>
                    <t t-set="receipt_number" t-value="o.sale_order_id.name if o.sale_order_id else (o.pos_reference if o.pos_reference else (pos_order.pos_reference if pos_order else o.appointment_ref))"/>

                    <t t-set="order_date" t-value="o.sale_order_id.date_order if o.sale_order_id else (pos_order.date_order if pos_order else o.date)"/>

                    <t t-set="app_slot" t-value="o.slot_ids[0] if o.slot_ids else False"/>
                    <t t-set="s_time_str" t-value="''"/>
                    <t t-if="app_slot">
                        <t t-set="time_float" t-value="app_slot.time"/>
                        <t t-set="s_hour" t-value="int(time_float)"/>
                        <t t-set="s_minute" t-value="int(round((time_float - s_hour) * 60))"/>
                        <t t-set="s_ampm" t-value="'مساءً' if s_hour &gt;= 12 else 'صباحاً'"/>
                        <t t-set="s_display_hour" t-value="s_hour - 12 if s_hour &gt; 12 else (12 if s_hour == 0 else s_hour)"/>
                        <t t-set="s_time_str" t-value="'%02d:%02d %s' % (s_display_hour, s_minute, s_ampm)"/>
                    </t>

                    <div style="border: 1px solid #e6e6e6; border-radius: 8px; margin-bottom: 12px; overflow: hidden;">
                        <div style="background-color: #fdf5f6; color: #df7b8e; text-align: center; padding: 6px; font-weight: bold; border-bottom: 1px solid #e6e6e6; font-size: 11px;">
                            <i class="fa fa-file-text-o" style="margin-left: 5px;"></i> بيانات الإيصال
                        </div>
                        <div style="padding: 8px; font-size: 11px; line-height: 1.8;">
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #555;">رقم الإيصال:</span>
                                <strong style="color: #000;"><t t-esc="receipt_number"/></strong>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #555;">التاريخ:</span>
                                <strong style="color: #000;"><span t-esc="order_date" t-options='{"widget": "date", "format": "dd-MM-yyyy"}'/></strong>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #555;">وقت الحجز:</span>
                                <strong style="color: #000;">
                                    <t t-if="s_time_str"><t t-esc="s_time_str"/></t>
                                    <t t-else=""><span t-esc="o.date" t-options='{"widget": "datetime", "format": "hh:mm a", "tz_name": "Asia/Riyadh"}'/></t>
                                </strong>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #555;">حالة الحجز:</span>
                                <strong style="color: #df7b8e;">
                                    <t t-if="o.state == '1'">مبدئي (بانتظار التأكيد)</t>
                                    <t t-elif="o.state == '2'">مؤكد</t>
                                    <t t-elif="o.state == '3'">مكتمل</t>
                                    <t t-elif="o.state == '4'">ملغي</t>
                                    <t t-else="">مؤكد</t>
                                </strong>
                            </div>
                        </div>
                    </div>

                    <div style="border: 1px solid #e6e6e6; border-radius: 8px; margin-bottom: 12px; overflow: hidden;">
                        <div style="background-color: #fdf5f6; color: #df7b8e; text-align: center; padding: 6px; font-weight: bold; border-bottom: 1px solid #e6e6e6; font-size: 11px;">
                            <i class="fa fa-user" style="margin-left: 5px;"></i> بيانات العميلة
                        </div>
                        <div style="padding: 8px; font-size: 11px; line-height: 1.8;">
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #555;">الاسم:</span>
                                <strong style="color: #000;"><t t-esc="o.with_context(lang='ar_001').partner_id.name"/></strong>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #555;">الجوال:</span>
                                <strong style="font-family: monospace; color: #000;"><t t-esc="o.partner_phone or '---'"/></strong>
                            </div>
                        </div>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px; border: 1px solid #df7b8e; table-layout: fixed;">
                        <tr style="background-color: #df7b8e; color: white; font-size: 10px; text-align: center; font-weight: bold;">
                            <th style="padding: 5px; border: 1px solid #df7b8e; width: 25%;">الموظفة</th>
                            <th style="padding: 5px; border: 1px solid #df7b8e; width: 35%;">الخدمة / المنتج</th>
                            <th style="padding: 5px; border: 1px solid #df7b8e; width: 20%;">السعر</th>
                            <th style="padding: 5px; border: 1px solid #df7b8e; width: 20%;">الضريبة</th>
                        </tr>
                        <tr style="text-align: center; font-size: 11px; color: #333; background-color: #fff;">
                            <td style="padding: 5px; border: 1px solid #e6e6e6; vertical-align: middle;">
                                <t t-esc="o.with_context(lang='ar_001').employee_id.name"/>
                            </td>
                            <td style="padding: 5px; border: 1px solid #e6e6e6; vertical-align: middle;">
                                <strong><t t-esc="o.with_context(lang='ar_001').product_id.name"/></strong><br/>
                                <span style="font-size: 9px; color: #df7b8e;">
                                    <t t-if="s_time_str"><t t-esc="s_time_str"/></t>
                                    <t t-else=""><span t-esc="o.date" t-options='{"widget": "datetime", "format": "hh:mm a", "tz_name": "Asia/Riyadh"}'/></t>
                                </span>
                            </td>
                            <td style="padding: 5px; border: 1px solid #e6e6e6; vertical-align: middle; font-weight: bold;">
                                <t t-if="pos_line"><t t-esc="'%.2f' % pos_line.price_subtotal_incl"/></t>
                                <t t-elif="o.sale_order_id"><t t-esc="'%.2f' % (sum(o.sale_order_id.order_line.mapped('price_total')))"/></t>
                                <t t-else=""><t t-esc="'%.2f' % taxes['total_included']"/></t>
                            </td>
                            <td style="padding: 5px; border: 1px solid #e6e6e6; vertical-align: middle;">
                                <t t-if="pos_line"><t t-esc="'%.2f' % (pos_line.price_subtotal_incl - pos_line.price_subtotal)"/></t>
                                <t t-elif="o.sale_order_id"><t t-esc="'%.2f' % (sum(o.sale_order_id.order_line.mapped('price_total')) - sum(o.sale_order_id.order_line.mapped('price_subtotal')))"/></t>
                                <t t-else=""><t t-esc="'%.2f' % (taxes['total_included'] - taxes['total_excluded'])"/></t>
                            </td>
                        </tr>
                    </table>

                    <div style="border: 1px solid #e6e6e6; border-radius: 8px; margin-bottom: 15px; padding: 8px; font-size: 11px;">
                        <strong style="color: #df7b8e;"><i class="fa fa-edit"></i> ملاحظات:</strong>
                        <div style="border-bottom: 1px dashed #ccc; width: 100%; height: 20px; margin-top: 5px;"></div>
                    </div>

                    <div style="text-align: center; margin-top: 15px; width: 100%;">
                        <t t-if="receipt_number">
                            <t t-set="clean_barcode_value" t-value="receipt_number.replace('طلب', 'Order').strip() if isinstance(receipt_number, str) else receipt_number"/>

                            <div t-out="clean_barcode_value"
                                 t-options="{'widget': 'barcode', 'type': 'Code128', 'width': 600, 'height': 150, 'img_style': 'width:100%;height:50px;'}"/>

                            <div style="font-size: 11px; font-weight: bold; margin-top: 4px; color: #333;">
                                <t t-esc="receipt_number"/>
                            </div>
                        </t>
                    </div>

                    <div style="text-align: center; border-top: 1px dashed #ccc; margin-top: 15px; padding-top: 10px; font-size: 12px; color: #555;">
                        <div style="font-weight: bold; color: #df7b8e;">شكراً لزيارتكم!</div>
                        <div style="margin-top: 8px; font-size: 16px;">
                            <i class="fa fa-instagram" style="color: #df7b8e; margin: 0 5px;"></i>
                            <i class="fa fa-snapchat-ghost" style="color: #df7b8e; margin: 0 5px;"></i>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>